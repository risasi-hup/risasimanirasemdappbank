    // Varsaılan Ağı Artık Base 
    let currentChainId = "0x38";
    let provider = null;
    let signer = null;
    let userAddress = null;
    let slippagePercent = 0.5;
    let activeTab = 'main';

    /* ===== v2: 20 TOKEN · GERÇEK FİYAT · CANLI BÜLTEN ===== */
    const LOGOS = { rsm: "data:image/webp;base64,", asm: "data:image/webp;base64," };
    /* Token simgeleri (üst bant, çiftler, havuz kartları, token kartı, kayıt paneli): yeni logolar GitHub'dan; açılmazsa gömülü logoya düşer.
       DEX ana logoları (sol panel aslan/kuzu, cüzdan rozeti, dönen halka) LOGOS ile aynen kalır. */
    const TOKEN_LOGO_SRC = { rsm: 'https://github.com/user-attachments/assets/7d137a26-dabe-4eaf-8cd4-bb854ca499cf', asm: 'https://github.com/user-attachments/assets/cbf7aef8-aeff-4f3f-8fe8-d97b08c6fd83' };
    const TL = k => TOKEN_LOGO_SRC[k] || LOGOS[k];
    function tlFix(img) { const k = img.getAttribute('data-k'); img.onerror = null; if (k && LOGOS[k]) img.src = LOGOS[k]; }
    const tlBack = src => { for (const k in TOKEN_LOGO_SRC) if (TOKEN_LOGO_SRC[k] === src) return LOGOS[k]; return null; };
    const BINANCE_HOSTS = ["https://api.binance.com", "https://data-api.binance.vision"];
    const PROJECT_NEWS_URL = "";   // İsteğe bağlı: kendi duyurularınız için JSON adresi → [{"time":"19 Eki","title":"...","url":"https://..."}]
    const TRANSFER_TOPIC = ethers.utils.id("Transfer(address,address,uint256)");
    const FACTORY_ABI = ["function getPair(address,address) view returns (address)"];
    const PAIR_ABI = ["function getReserves() view returns (uint112 r0, uint112 r1, uint32 t)", "function token0() view returns (address)"];
    // V3 fabrikası ve Goodwill lisans geçidi (adresler küçük harfe çevrilip sağlama toplamı ethers'e hesaplatılır)
    const V3_FACTORY = ethers.utils.getAddress("0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865".toLowerCase());
    const GATEWAY = ethers.utils.getAddress("0x06068542158964ebbd85e9a16C80702e4795C39F".toLowerCase());
    const V3_FEES = [100, 500, 2500, 10000];
    const V3F_ABI = ["function getPool(address,address,uint24) view returns (address)"];
    const V3P_ABI = ["function slot0() view returns (uint160 sqrtPriceX96, int24 tick, uint16 a, uint16 b, uint16 c, uint32 fp, bool u)", "function token0() view returns (address)"];
    const GATEWAY_ABI = ["function isLicensed(address) view returns (bool)"];
    let uiLang = 'tr', lastBnbUsd = 0, newsData = { hot: [], proj: [], bin: [], src: "", stamp: null }, newsCache = { t: 0, v: null };
    const lastQuote = {}; let quoteSeq = 0;

    // Seçili ağ için salt-okunur RPC (yedekli). Cüzdan hangi ağda olursa olsun fiyat/teklif doğru zincirden okunur.
    const rpcCache = {};
    function readRpc(chainId) {
        if (rpcCache[chainId]) return rpcCache[chainId];
        const net = NETWORKS[chainId], id = parseInt(chainId, 16);
        return rpcCache[chainId] = new ethers.providers.FallbackProvider(
            net.rpcUrls.map((u, i) => ({ provider: new ethers.providers.StaticJsonRpcProvider(u, { chainId: id, name: net.name }), priority: i + 1, weight: 1, stallTimeout: 2500 })), 1);
    }
    const pending = t => !!(t.ex || t.rd) && t.ok !== true;
    const stableOf = net => net.tokens.find(t => t.symbol === "USDT") || net.tokens.find(t => t.symbol === "USDC");
    const shortAddr = a => a.slice(0, 6) + '…' + a.slice(-4);
    function fmtPrice(p) {
        if (p >= 1000) return p.toLocaleString('en-US', { maximumFractionDigits: 2 });
        if (p >= 1) return p.toFixed(2);
        if (p >= 0.01) return p.toFixed(4);
        if (p >= 0.0001) return p.toFixed(6);
        return p.toFixed(10).replace(/0+$/, '');
    }
    function fmtBig(n) { return n >= 1e12 ? (n / 1e12).toFixed(2) + 'T' : n >= 1e9 ? (n / 1e9).toFixed(2) + 'B' : n >= 1e6 ? (n / 1e6).toFixed(2) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(2) + 'K' : n.toFixed(n < 1 ? 6 : 2); }

    // Her token adresi zincirden doğrulanır: sembol (ex) ve ondalık (decimals) okunur, uyuşmayan token listeden çıkarılır.
    // Adresler sabit ve sağlama toplamlıdır; sembol kontrolü tek başına sahte "kopya" tokenları yakalamaz.
    async function verifyTokens(retry = 0) {
        const net = NETWORKS["0x38"], rp = readRpc("0x38"), before = net.tokens.length;
        await Promise.all(net.tokens.filter(t => (t.ex || t.rd) && t.ok === undefined).map(async t => {
            try {
                ethers.utils.getAddress(t.address);   // sağlama toplamı bozuksa hata verir
                const c = new ethers.Contract(t.address, ERC20_ABI, rp);
                const [s, d] = await Promise.all([t.ex ? c.symbol() : Promise.resolve(""), c.decimals()]);
                if (t.ex && String(s).toUpperCase() !== t.ex) { t.ok = false; console.warn("Sembol uyuşmadı, token çıkarıldı:", t.symbol, s); return; }
                t.decimals = Number(d); t.ok = true;
            } catch (e) {
                if (e.code === 'CALL_EXCEPTION' || /checksum|invalid address/i.test(e.message || '')) { t.ok = false; console.warn("Token geçersiz, çıkarıldı:", t.symbol, e.message || e); }
                // aksi halde (ağ hatası) token beklemede kalır ve yeniden denenir
            }
        }));
        net.tokens = net.tokens.filter(t => t.ok !== false);
        if (net.tokens.length !== before) populateTokenDropdowns(); else calculateQuote(activeTab);
        if (net.tokens.some(t => (t.ex || t.rd) && t.ok === undefined) && retry < 4) setTimeout(() => verifyTokens(retry + 1), 4000);
    }

    /* ===== CÜZDAN BAĞLANTISI: tarayıcı cüzdanları (EIP-6963) · cüzdan içi tarayıcı · mobilde cüzdan uygulamasında açma · WalletConnect v2 =====
       Özel anahtar sorulmaz; imza ve onaylar yalnız cüzdanda verilir. Bağlantı yalnız kullanıcı dokununca başlar. */
    const WC_PROJECT_ID = '';   // cloud.reown.com'da ücretsiz Project ID alıp buraya yazın (Netlify adresinizi izinli alan adlarına ekleyin)
    var walletProvider = null; const found6963 = []; const _bound = new WeakSet(); let _wcP = null;
    const getEth = () => walletProvider || window.ethereum;
    window.addEventListener('eip6963:announceProvider', e => { const d = e.detail; if (d && d.info && d.provider && !found6963.some(x => x.info.uuid === d.info.uuid)) found6963.push(d); });
    window.dispatchEvent(new Event('eip6963:requestProvider'));
    const wName = e => (e.isTrust || e.isTrustWallet) ? 'Trust Wallet' : e.isCoinbaseWallet ? 'Coinbase Wallet' : e.isMetaMask ? 'MetaMask' : 'Tarayıcı cüzdanı';

    function bindWalletEvents(eth) {   // dinleyiciler sağlayıcı başına yalnız bir kez
        if (!eth || !eth.on || _bound.has(eth)) return; _bound.add(eth);
        eth.on('accountsChanged', a => { if (a && a.length) connectWallet(true); else location.reload(); });
        eth.on('chainChanged', () => location.reload());
        eth.on('disconnect', () => { try { localStorage.removeItem('wc_on'); } catch (e) {} location.reload(); });
    }
    async function walletDisconnect() {
        try { if (walletProvider && walletProvider.disconnect) await walletProvider.disconnect(); } catch (e) {}
        try { localStorage.removeItem('wc_on'); localStorage.setItem('wallet_off', '1'); } catch (e) {}
        location.reload();
    }
    document.addEventListener('visibilitychange', async () => {   // cüzdan uygulamasından dönünce hesabı tazele
        if (document.hidden || !userAddress || !getEth()) return;
        try { const a = await getEth().request({ method: 'eth_accounts' }); if (!a.length) location.reload(); else if (a[0].toLowerCase() !== userAddress.toLowerCase()) connectWallet(true); } catch (e) {}
    });

    async function wcProvider() {
        if (_wcP) return _wcP;
        if (!window['@walletconnect/ethereum-provider']) {
            let ok = false;
            for (const u of ['https://cdn.jsdelivr.net/npm/@walletconnect/ethereum-provider@2.17.0/dist/index.umd.js', 'https://unpkg.com/@walletconnect/ethereum-provider@2.17.0/dist/index.umd.js']) {
                try { await new Promise((res, rej) => { const s = document.createElement('script'); s.src = u; s.async = true; s.crossOrigin = 'anonymous'; s.referrerPolicy = 'no-referrer'; s.onload = res; s.onerror = () => { s.remove(); rej(); }; document.head.appendChild(s); }); ok = true; break; } catch (e) {}
            }
            if (!ok) throw new Error('WalletConnect yüklenemedi');
        }
        const ns = window['@walletconnect/ethereum-provider'] || {}, EP = ns.EthereumProvider || (ns.default && ns.default.EthereumProvider) || ns.default;
        if (!EP || !EP.init) throw new Error('WalletConnect hazır değil');
        const ids = Object.keys(NETWORKS).map(k => parseInt(k, 16)), rpcMap = {}; Object.keys(NETWORKS).forEach(k => { rpcMap[parseInt(k, 16)] = NETWORKS[k].rpcUrls[0]; });
        _wcP = await EP.init({ projectId: WC_PROJECT_ID, chains: [56], optionalChains: ids, showQrModal: true, rpcMap,
            methods: ['eth_sendTransaction', 'personal_sign'], optionalMethods: ['wallet_switchEthereumChain', 'wallet_addEthereumChain', 'wallet_watchAsset', 'eth_signTypedData_v4'], events: ['chainChanged', 'accountsChanged'],
            metadata: { name: 'RISASIMANI DEX', description: 'BNB Smart Chain takas arayüzü', url: location.origin, icons: [location.origin + '/logos/rsm-256.png'] } });
        return _wcP;
    }
    async function connectWC() {
        try {
            const wp = await wcProvider();
            if (!wp.session) await wp.connect();   // QR (masaüstü) · cüzdan listesi ve derin bağlantı (mobil)
            walletProvider = wp; try { localStorage.setItem('wc_on', '1'); } catch (e) {}
            closeWalletModal(); connectWallet();
        } catch (e) { showToast('WalletConnect bağlantısı tamamlanmadı' + (e && e.message ? ': ' + e.message : ''), 'error'); }
    }
    function pickWallet(w) { walletProvider = w.provider; try { localStorage.setItem('wallet_last', w.info.rdns || ''); } catch (e) {} closeWalletModal(); connectWallet(); }
    function closeWalletModal() { const m = document.getElementById('wm-modal'); if (m) m.remove(); }
    function openWalletModal() {
        closeWalletModal();
        const bg = document.createElement('div'); bg.className = 'wm-bg'; bg.id = 'wm-modal'; bg.onclick = e => { if (e.target === bg) closeWalletModal(); };
        const box = document.createElement('div'); box.className = 'wm-box'; box.setAttribute('role', 'dialog'); box.setAttribute('aria-modal', 'true');
        const hd = document.createElement('div'); hd.className = 'wm-h'; hd.appendChild(document.createTextNode('CÜZDAN SEÇ'));
        const x = document.createElement('button'); x.className = 'wm-x'; x.textContent = '✕'; x.onclick = closeWalletModal; hd.appendChild(x); box.appendChild(hd);
        const sec = t => { const d = document.createElement('div'); d.className = 'wm-sec'; d.textContent = t; box.appendChild(d); };
        const btn = (label, icon, fn, href) => {
            const b = document.createElement(href ? 'a' : 'button'); b.className = 'wm-btn';
            if (href) { b.href = href; b.rel = 'noopener noreferrer'; } else b.onclick = fn;
            if (icon && /^data:image\/(png|svg\+xml|webp|jpeg|gif);base64,/.test(icon)) { const i = document.createElement('img'); i.alt = ''; i.src = icon; b.appendChild(i); }
            b.appendChild(document.createTextNode(label)); box.appendChild(b);
        };
        const list = found6963.length ? found6963 : (window.ethereum ? [{ info: { name: wName(window.ethereum), icon: '', rdns: '' }, provider: window.ethereum }] : []);
        if (list.length) { sec('BU CİHAZDAKİ CÜZDANLAR'); list.forEach(w => btn(String(w.info.name).slice(0, 30), w.info.icon, () => pickWallet(w))); }
        if (WC_PROJECT_ID) { sec('MOBİL CÜZDAN · QR VEYA UYGULAMA'); btn('WalletConnect', '', connectWC); }
        if (!window.ethereum) {
            const here = location.href.split('#')[0];
            sec('CÜZDAN UYGULAMASINDA AÇ (SAYFA CÜZDANIN İÇ TARAYICISINDA AÇILIR)');
            btn('MetaMask', '', null, 'https://metamask.app.link/dapp/' + here.replace(/^https?:\/\//, ''));
            btn('Trust Wallet', '', null, 'https://link.trustwallet.com/open_url?coin_id=20000714&url=' + encodeURIComponent(here));
            btn('Coinbase Wallet', '', null, 'https://go.cb-w.com/dapp?cb_url=' + encodeURIComponent(here));
        }
        const nt = document.createElement('div'); nt.className = 'wm-note'; nt.textContent = 'Özel anahtar veya kurtarma ifadesi istenmez. Her işlemi cüzdanınızda onaylarsınız.'; box.appendChild(nt);
        bg.appendChild(box); document.body.appendChild(bg);
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeWalletModal(); });

    // Sayfa yenilenince (chainChanged) seçili ağı ve izin verilmiş cüzdanı sessizce geri yükler.
    async function restoreWallet() {
        try { if (localStorage.getItem('wallet_off') === '1') return; } catch (e) {}
        await new Promise(r => setTimeout(r, 250));   // EIP-6963 duyurularını bekle
        if (!walletProvider) { let last = null; try { last = localStorage.getItem('wallet_last'); } catch (e) {} const m = last && found6963.find(w => w.info.rdns === last); if (m) walletProvider = m.provider; }
        if (!walletProvider && WC_PROJECT_ID) { let on = null; try { on = localStorage.getItem('wc_on'); } catch (e) {} if (on === '1') { try { const wp = await wcProvider(); if (wp.session) walletProvider = wp; else localStorage.removeItem('wc_on'); } catch (e) {} } }
        if (!getEth()) return;
        provider = new ethers.providers.Web3Provider(getEth());
        try {
            const cid = await getEth().request({ method: 'eth_chainId' });
            if (NETWORKS[cid]) { currentChainId = cid; document.getElementById('network-selector').value = cid; }
            const acc = await getEth().request({ method: 'eth_accounts' });
            if (acc.length) await connectWallet(true);
        } catch (e) {}
    }

    // İşlem göndermeden önce cüzdan, seçili ağda mı?
    async function ensureChain() {
        const cid = await getEth().request({ method: 'eth_chainId' });
        if (cid === currentChainId) return;
        await switchNetwork(currentChainId);
        throw new Error("Cüzdan ağı değiştiriliyor; sayfa yenilenince işlemi tekrar başlatın.");
    }


    function showToast(msg, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        const sp = document.createElement('span'); sp.textContent = msg; toast.appendChild(sp);
        const xb = document.createElement('button'); xb.textContent = '✕'; xb.style.cssText = 'background:none;border:none;color:#aaa;cursor:pointer;margin-left:10px;'; xb.onclick = () => toast.remove(); toast.appendChild(xb);
        container.appendChild(toast);
        setTimeout(() => { if(toast.parentElement) toast.remove(); }, 4500);
    }

    function setSlippage(val, btn) {
        slippagePercent = val;
        document.querySelectorAll('.slip-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        calculateQuote(activeTab);
    }

    function switchTab(tabId, btnElement) {
        if (tabId === 'arb' && !arbOk()) return;
        if (tabId !== 'addtoken') activeTab = tabId;
        document.querySelectorAll('.swap-container').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        
        document.getElementById('tab-' + tabId).classList.add('active');
        btnElement.classList.add('active');
        
        if (tabId === 'arb') arbRefresh(); else if (tabId === 'addtoken') atRefresh(); else onTokenChange(tabId);
    }

    function populateTokenDropdowns() {
        const net = NETWORKS[currentChainId];
        ctkLoad(net);
        const mainFrom = document.getElementById('main-from-token');
        const mainTo = document.getElementById('main-to-token');
        const btcFrom = document.getElementById('btc-from-token');
        const btcTo = document.getElementById('btc-to-token');
        const ethFrom = document.getElementById('eth-from-token');
        const ethTo = document.getElementById('eth-to-token');

        const optionsHTML = net.tokens.map(t => `<option value="${t.symbol}">${t.symbol}</option>`).join('');

        mainFrom.innerHTML = optionsHTML;
        mainTo.innerHTML = optionsHTML;
        
        if(net.tokens.length > 1) {
            mainFrom.selectedIndex = 0;
            mainTo.selectedIndex = 1;
        }

        btcFrom.innerHTML = optionsHTML;
        const btcToken = net.tokens.find(t => t.symbol.includes('BTC')) || net.tokens[0];
        btcTo.innerHTML = `<option value="${btcToken.symbol}">${btcToken.symbol}</option>`;

        ethFrom.innerHTML = optionsHTML;
        const ethToken = net.tokens.find(t => t.symbol === 'ETH' || t.symbol === 'WETH') || net.tokens[0];
        ethTo.innerHTML = `<option value="${ethToken.symbol}">${ethToken.symbol}</option>`;

        document.getElementById('main-router-tag').innerText = net.name.toUpperCase() + " ROUTER";

        drawAllChips();
        updateAllBalances();
        calculateQuote(activeTab);
    }

    async function switchNetwork(chainIdHex) {
        currentChainId = chainIdHex;
        populateTokenDropdowns();
        fetchLiveMarketData(); // Ağı değiştirince yan paneli de yeniden hesapla

        if (getEth()) {
            try {
                await getEth().request({
                    method: 'wallet_switchEthereumChain',
                    params: [{ chainId: chainIdHex }],
                });
                showToast(`Ağ Değiştirildi: ${NETWORKS[chainIdHex].name}`, 'success');
            } catch (switchError) {
                if (switchError.code === 4902) {
                    try {
                        const net = NETWORKS[chainIdHex];
                        await getEth().request({
                            method: 'wallet_addEthereumChain',
                            params: [{
                                chainId: net.chainId,
                                chainName: net.chainName,
                                nativeCurrency: net.nativeCurrency,
                                rpcUrls: net.rpcUrls,
                                blockExplorerUrls: net.blockExplorerUrls
                            }],
                        });
                    } catch (addError) {
                        showToast("Ağ eklenirken hata oluştu: " + addError.message, 'error');
                    }
                }
            }
        }
    }

    async function connectWallet(auto) {
        if (!window.isSecureContext) { showToast('Güvenli bağlantı (https) gerekli', 'error'); return; }
        if (!auto) { try { localStorage.removeItem('wallet_off'); } catch (e) {} }
        if (!getEth() && !walletProvider || (!auto && !walletProvider && found6963.length > 1)) { openWalletModal(); return; }
        try {
            provider = new ethers.providers.Web3Provider(getEth());
            await provider.send("eth_requestAccounts", []);
            signer = provider.getSigner();
            userAddress = await signer.getAddress();

            const network = await provider.getNetwork();
            const hexChain = "0x" + network.chainId.toString(16);
            if (NETWORKS[hexChain]) {
                currentChainId = hexChain;
                document.getElementById('network-selector').value = hexChain;
            }

            renderStatus();
            document.getElementById('status').style.color = 'var(--cyber-green)';
            
            document.getElementById('connect-btn').style.background = "#0c281e";
            document.getElementById('connect-btn').style.color = "var(--cyber-green)";

            populateTokenDropdowns();
            showToast(tLoc("Web3 Cüzdanı Bağlandı ve Bakiyeler Çekildi!"), "success");
            try { onRsmWalletConnected(); } catch (e) {}

            bindWalletEvents(getEth()); const db = document.getElementById('disc-btn'); if (db) db.style.display = 'inline-block';

        } catch (err) {
            showToast(err && err.code === 4001 ? 'Bağlantı cüzdanda reddedildi' : err && err.code === -32002 ? 'Cüzdanda bekleyen bir bağlantı isteği var; cüzdan uygulamasını açıp onaylayın' : 'Cüzdan bağlantı hatası: ' + ((err && err.message) || err), 'error');
        }
    }

    /* Real-Time Wallet Balance Query Engine */
    async function getBalanceForToken(tokenSymbol) {
        if (!userAddress || !provider) return "0.00";
        try {
            const net = NETWORKS[currentChainId];
            const token = net.tokens.find(t => t.symbol === tokenSymbol);
            if (!token) return "0.00";

            if (token.isNative) {
                const rawBal = await readRpc(currentChainId).getBalance(userAddress);
                return parseFloat(ethers.utils.formatEther(rawBal)).toFixed(4);
            } else {
                const contract = new ethers.Contract(token.address, ERC20_ABI, readRpc(currentChainId));
                const rawBal = await contract.balanceOf(userAddress);
                return parseFloat(ethers.utils.formatUnits(rawBal, token.decimals)).toFixed(4);
            }
        } catch (e) {
            return "0.00";
        }
    }

    async function updateAllBalances() {
        refreshOwnerUI();
        if (!userAddress) return;
        const tab = activeTab;
        const fromSym = document.getElementById(`${tab}-from-token`).value;
        const toSym = document.getElementById(`${tab}-to-token`).value;

        const fromBal = await getBalanceForToken(fromSym);
        const toBal = await getBalanceForToken(toSym);

        document.getElementById(`${tab}-from-bal`).innerText = fromBal;
        document.getElementById(`${tab}-to-bal`).innerText = toBal;
    }

    function onTokenChange(tab) {
        drawChips(tab);
        updateAllBalances();
        calculateQuote(tab);
    }

    function flipTokens(tab) {
        const fromSel = document.getElementById(`${tab}-from-token`);
        const toSel = document.getElementById(`${tab}-to-token`);
        const temp = fromSel.value;
        fromSel.value = toSel.value;
        toSel.value = temp;
        onTokenChange(tab);
    }

    /* On-Chain Quote Calculation Engine (okuma RPC; son teklif saklanır, minimum çıktı ondan hesaplanır) */
    async function calculateQuote(tab) {
        if (!document.getElementById(`${tab}-from-amount`)) return;
        const seq = ++quoteSeq;
        const amountIn = document.getElementById(`${tab}-from-amount`).value;
        const outInput = document.getElementById(`${tab}-to-amount`);
        const rateLabel = document.getElementById(`${tab}-exchange-rate`);
        const approveBtn = document.getElementById(`${tab}-approve-btn`);
        const swapBtn = document.getElementById(`${tab}-swap-btn`);
        const lock = msg => { outInput.value = msg || ""; delete lastQuote[tab]; if (approveBtn) approveBtn.disabled = true; if (swapBtn) swapBtn.disabled = true; };

        if (!amountIn || parseFloat(amountIn) <= 0) { lock(""); if (rateLabel) rateLabel.innerText = "1 Token = --"; return; }

        const net = NETWORKS[currentChainId];
        const fromSym = document.getElementById(`${tab}-from-token`).value;
        const toSym = document.getElementById(`${tab}-to-token`).value;
        const fromToken = net.tokens.find(t => t.symbol === fromSym);
        const toToken = net.tokens.find(t => t.symbol === toSym);
        if (!fromToken || !toToken || fromSym === toSym) { lock(tLoc("Geçersiz Çift")); return; }
        const addrIn = fromToken.isNative ? net.wNative : fromToken.address;
        const addrOut = toToken.isNative ? net.wNative : toToken.address;
        if (addrIn.toLowerCase() === addrOut.toLowerCase()) { lock(tLoc("Geçersiz Çift")); return; }
        if (pending(fromToken) || pending(toToken)) { lock(tLoc("Token doğrulanıyor...")); return; }

        try {
            const rp = readRpc(currentChainId);
            const router = new ethers.Contract(net.routerAddress, ROUTER_ABI, rp);
            const parsedIn = ethers.utils.parseUnits(amountIn.toString(), fromToken.decimals);

            let path = [addrIn, addrOut], amounts;
            try { amounts = await router.getAmountsOut(parsedIn, path); }
            catch (directError) {
                // Otomatik yönlendirme: doğrudan havuz yoksa yerel sarmalı token (WBNB / WETH) üzerinden
                if (addrIn !== net.wNative && addrOut !== net.wNative) { path = [addrIn, net.wNative, addrOut]; amounts = await router.getAmountsOut(parsedIn, path); }
                else throw directError;
            }
            if (seq !== quoteSeq) return;   // daha yeni bir istek var, bu cevap eski

            const out = amounts[amounts.length - 1];
            const calculatedOut = ethers.utils.formatUnits(out, toToken.decimals);
            lastQuote[tab] = { out, path, from: fromSym, to: toSym, amt: amountIn };
            outInput.value = parseFloat(calculatedOut).toFixed(6);
            if (rateLabel) rateLabel.innerText = `1 ${fromSym} ≈ ${fmtPrice(parseFloat(calculatedOut) / parseFloat(amountIn))} ${toSym}` + (path.length > 2 ? " (via " + (net.nativeCurrency.symbol === "BNB" ? "WBNB" : "WETH") + ")" : "");

            if (userAddress && !fromToken.isNative) {
                const allowance = await new ethers.Contract(fromToken.address, ERC20_ABI, rp).allowance(userAddress, net.routerAddress);
                if (seq !== quoteSeq) return;
                if (allowance.gte(parsedIn)) { if (approveBtn) { approveBtn.disabled = true; approveBtn.innerText = tLoc("ONAYLANDI ✓"); } if (swapBtn) swapBtn.disabled = false; }
                else { if (approveBtn) { approveBtn.disabled = false; approveBtn.innerText = `${fromSym} ONAYLA`; } if (swapBtn) swapBtn.disabled = true; }
            } else {
                if (approveBtn) { approveBtn.disabled = true; approveBtn.innerText = tLoc("ONAY GEREKMİYOR"); }
                if (swapBtn) swapBtn.disabled = !userAddress;
            }
        } catch (e) {
            if (seq !== quoteSeq) return;
            console.error("Quote / Liquidity Error:", e);
            lock(tLoc("Likidite Yetersiz"));
            if (rateLabel) rateLabel.innerText = tLoc("Likidite Havuzu Bulunamadı");
        }
    }

    /* On-Chain ERC-20 Approve Engine — yalnızca bu takasın tutarı kadar izin (sınırsız izin yok) */
    async function executeApprove(tab) {
        if (!signer || !userAddress) { showToast(tLoc("Lütfen önce cüzdanınızı bağlayın!"), "error"); return; }
        const net = NETWORKS[currentChainId];
        const fromSym = document.getElementById(`${tab}-from-token`).value;
        const fromToken = net.tokens.find(t => t.symbol === fromSym);
        if (!fromToken || fromToken.isNative || pending(fromToken)) return;
        try {
            await ensureChain();
            const amt = ethers.utils.parseUnits(document.getElementById(`${tab}-from-amount`).value.toString(), fromToken.decimals);
            const erc20 = new ethers.Contract(fromToken.address, ERC20_ABI, signer);
            showToast(`${fromSym} için onay işlemi başlatılıyor...`, "info");
            const tx = await erc20.approve(net.routerAddress, amt);
            showToast(`İşlem Onayı Gönderildi! Tx: ${tx.hash.substring(0, 10)}...`, "info");
            await tx.wait();
            showToast(`${fromSym} Onaylandı! Takas edebilirsiniz.`, "success");
            calculateQuote(tab);
        } catch (err) { showToast("Onaylama Başarısız: " + (err.reason || err.message), "error"); }
    }

    /* On-Chain Real Swap Execution Engine — vergili/transfer ücretli tokenlar için SupportingFeeOnTransfer fonksiyonları */
    async function executeSwap(tab) {
        if (!signer || !userAddress) { showToast(tLoc("Lütfen önce cüzdanınızı bağlayın!"), "error"); return; }
        const amountInVal = document.getElementById(`${tab}-from-amount`).value;
        const net = NETWORKS[currentChainId];
        const fromSym = document.getElementById(`${tab}-from-token`).value;
        const toSym = document.getElementById(`${tab}-to-token`).value;
        const fromToken = net.tokens.find(t => t.symbol === fromSym);
        const toToken = net.tokens.find(t => t.symbol === toSym);
        const q = lastQuote[tab];
        if (!fromToken || !toToken || !q || q.from !== fromSym || q.to !== toSym || q.amt !== amountInVal) {
            showToast(tLoc("Teklif yenileniyor — birkaç saniye sonra tekrar deneyin."), "error"); calculateQuote(tab); return;
        }
        try {
            await ensureChain();
            const router = new ethers.Contract(net.routerAddress, ROUTER_ABI, signer);
            const parsedIn = ethers.utils.parseUnits(amountInVal.toString(), fromToken.decimals);
            const amountOutMin = q.out.mul(1000 - Math.floor(slippagePercent * 10)).div(1000);   // tam (yuvarlanmamış) teklif üzerinden
            const deadline = Math.floor(Date.now() / 1000) + 60 * 20;
            showToast(tLoc("Takas işlemi Cüzdanda Onay Bekliyor..."), "info");
            let tx;
            if (fromToken.isNative) tx = await router.swapExactETHForTokensSupportingFeeOnTransferTokens(amountOutMin, q.path, userAddress, deadline, { value: parsedIn });
            else if (toToken.isNative) tx = await router.swapExactTokensForETHSupportingFeeOnTransferTokens(parsedIn, amountOutMin, q.path, userAddress, deadline);
            else tx = await router.swapExactTokensForTokensSupportingFeeOnTransferTokens(parsedIn, amountOutMin, q.path, userAddress, deadline);
            showToast(`Takas Gönderildi! Tx: ${tx.hash.substring(0, 12)}...`, "info");
            await tx.wait();
            showToast(tLoc(`🎉 SWAP İŞLEMİ BAŞARIYLA TAMAMLANDI!`), "success");
            updateAllBalances(); calculateQuote(tab);
        } catch (err) {
            console.error("Swap Error:", err);
            showToast("Takas Hatası: " + (err.reason || err.message), "error");
        }
    }

    /* ===== GERÇEK FİYATLAR: Binance (listeli tokenler) + zincir (RSM, ASM ve Binance'te olmayanlar) ===== */
    async function binanceTickers(symbols) {
        const q = encodeURIComponent(JSON.stringify(symbols));
        for (const host of BINANCE_HOSTS) {
            for (const url of [`${host}/api/v3/ticker/24hr?symbols=${q}`, `${host}/api/v3/ticker/24hr`]) {
                try {
                    const r = await fetch(url, { cache: "no-store" });
                    if (!r.ok) continue;
                    const m = {};
                    (await r.json()).forEach(i => { if (symbols.includes(i.symbol)) m[i.symbol] = { p: parseFloat(i.lastPrice), c: parseFloat(i.priceChangePercent) }; });
                    if (Object.keys(m).length) return m;
                } catch (e) {}
            }
        }
        return {};
    }

    // 1 token'in dolar karşılığı: yönlendirici havuzundan canlı (önce doğrudan, sonra yerel token üzerinden)
    async function onchainUsd(net, rp, token, stable) {
        const router = new ethers.Contract(net.routerAddress, ROUTER_ABI, rp);
        const one = ethers.utils.parseUnits("1", token.decimals);
        const ta = token.isNative ? net.wNative : token.address;
        for (const path of (ta.toLowerCase() === net.wNative.toLowerCase() ? [[ta, stable.address]] : [[ta, stable.address], [ta, net.wNative, stable.address]])) {
            try { const a = await router.getAmountsOut(one, path); return parseFloat(ethers.utils.formatUnits(a[a.length - 1], stable.decimals)); } catch (e) {}
        }
        return null;
    }

    function sideCard(t, p, stableSym) {
        const d = document.createElement('div');
        d.className = 'rsm-market-widget'; d.style.marginBottom = '12px';
        const h4 = document.createElement('h4');
        if (p == null) { d.style.opacity = '0.6'; h4.textContent = `⚠️ ${t.symbol} / ${stableSym}`; }
        else if (t.logo) { const im = document.createElement('img'); im.src = TL(t.logo); im.dataset.k = t.logo; im.onerror = () => tlFix(im); im.className = 'tick-ico'; h4.appendChild(im); h4.appendChild(document.createTextNode(`${t.symbol} / ${stableSym} (Canlı)`)); }
        else h4.textContent = `🦁 ${t.symbol} / ${stableSym} (Canlı)`;
        const v = document.createElement('div');
        v.style.cssText = 'font-size:0.95rem; text-align:center; font-weight:bold; color:var(--cyber-green);';
        if (p == null) { v.style.cssText = 'font-size:0.75rem; text-align:center; color:#aaa;'; v.textContent = tLoc('Likidite Bekleniyor'); } else v.textContent = '$' + fmtPrice(p);
        d.appendChild(h4); d.appendChild(v); return d;
    }

    /* ===== RSM/ASM x WBNB/USDT: gerçek V2 + V3 havuz okuma, Goodwill lisans rozeti ===== */
    function poolCard(t, q, best, usd, lic) {
        const d = document.createElement('div'); d.className = 'rsm-market-widget'; d.style.marginBottom = '12px';
        const h = document.createElement('h4'), im = document.createElement('img'); im.src = TL(t.logo); im.dataset.k = t.logo; im.onerror = () => tlFix(im); im.className = 'tick-ico';
        h.appendChild(im); h.appendChild(document.createTextNode(`${t.tk} / ${q.symbol}`)); d.appendChild(h);
        const line = (txt, css) => { const e = document.createElement('div'); e.style.cssText = css; e.textContent = txt; d.appendChild(e); return e; };
        const link = (txt, href, css) => { const a = Object.assign(document.createElement('a'), { href, target: '_blank', rel: 'noopener noreferrer', textContent: txt }); a.style.cssText = css; d.appendChild(a); };
        if (!best) {
            d.style.opacity = '0.75';
            line(tLoc('Havuz yok · likidite bekleniyor'), 'font-size:0.72rem;text-align:center;color:#aaa;');
            link(tLoc('Havuz oluştur ↗'), `https://pancakeswap.finance/add/${q.symbol === 'WBNB' ? 'BNB' : q.address}/${t.address}?chain=bsc`, 'display:block;text-align:center;font-size:0.7rem;color:var(--neon-gold);margin-top:4px;');
        } else {
            line('$' + fmtPrice(usd), 'font-size:0.95rem;text-align:center;font-weight:bold;color:var(--cyber-green);');
            link(`${best.v} · likidite ≈ $${fmtBig(best.tvl)} ↗`, 'https://bscscan.com/address/' + best.a, 'display:block;text-align:center;font-size:0.68rem;color:#aaa;margin-top:3px;');
        }
        if (lic === true) line(tLoc('✓ Goodwill lisanslı'), 'font-size:0.66rem;text-align:center;color:var(--gold);margin-top:3px;');
        else if (lic === false) line(tLoc('✗ Goodwill lisansı yok'), 'font-size:0.66rem;text-align:center;color:var(--cyber-red);margin-top:3px;');
        return d;
    }

    async function poolBox(t, q, lic) {
        const bsc = NETWORKS["0x38"], rp = readRpc("0x38"), L = a => a.toLowerCase(), cands = [];
        try {
            const fac = new ethers.Contract(await new ethers.Contract(bsc.routerAddress, ROUTER_ABI, rp).factory(), FACTORY_ABI, rp);
            const a = await fac.getPair(t.address, q.address);
            if (a !== ethers.constants.AddressZero) cands.push({ v: "V2", a });
        } catch (e) {}
        try {
            const f3 = new ethers.Contract(V3_FACTORY, V3F_ABI, rp);
            await Promise.all(V3_FEES.map(async fee => {
                const a = await f3.getPool(t.address, q.address, fee);
                if (a !== ethers.constants.AddressZero) cands.push({ v: "V3 " + (fee / 10000) + "%", a, v3: true });
            }));
        } catch (e) {}
        const qUsd = q.symbol === "WBNB" ? await bnbUsd() : 1, qc = new ethers.Contract(q.address, ERC20_ABI, rp);
        let best = null, usd = null;
        for (const c of cands) {
            try {
                c.tvl = parseFloat(ethers.utils.formatUnits(await qc.balanceOf(c.a), q.decimals)) * 2 * qUsd;
                if (!best || c.tvl > best.tvl) best = c;
            } catch (e) {}
        }
        if (best && best.tvl > 0) {
            try {
                let p;
                if (best.v3) {
                    const pc = new ethers.Contract(best.a, V3P_ABI, rp), [s, t0] = await Promise.all([pc.slot0(), pc.token0()]);
                    const r = (parseFloat(s[0].toString()) / 2 ** 96) ** 2, isT0 = L(t0) === L(t.address);
                    p = isT0 ? r * 10 ** (t.decimals - q.decimals) : 1 / (r * 10 ** (q.decimals - t.decimals));
                } else {
                    const pc = new ethers.Contract(best.a, PAIR_ABI, rp), [r, t0] = await Promise.all([pc.getReserves(), pc.token0()]);
                    const isT0 = L(t0) === L(t.address);
                    p = parseFloat(ethers.utils.formatUnits(isT0 ? r.r1 : r.r0, q.decimals)) / parseFloat(ethers.utils.formatUnits(isT0 ? r.r0 : r.r1, t.decimals));
                }
                usd = p * qUsd;
            } catch (e) {}
        }
        if (usd != null && isFinite(usd) && usd > 0 && best && t.logo && (!poolPx[t.logo] || best.tvl >= poolPx[t.logo].tvl)) poolPx[t.logo] = { usd, tvl: best.tvl };
        return poolCard(t, q, usd != null && isFinite(usd) && usd > 0 ? best : null, usd, lic);
    }

    // DexScreener yedeği: zincirden (RPC) fiyat gelmezse BSC'deki en likit çiftin USD fiyatı
    const _dsMemo = {};
    function dsPrice(addr) {
        const k = addr.toLowerCase(), now = Date.now();
        if (_dsMemo[k] && now - _dsMemo[k].t < 20000) return _dsMemo[k].p;
        const p = (async () => {
            const ctl = new AbortController(), to = setTimeout(() => ctl.abort(), 7000);
            try {
                const r = await fetch('https://api.dexscreener.com/token-pairs/v1/bsc/' + addr, { signal: ctl.signal, cache: 'no-store' });
                if (!r.ok) throw new Error('ds ' + r.status);
                const arr = await r.json(); let best = null;
                (Array.isArray(arr) ? arr : (arr.pairs || [])).forEach(x => {
                    const usd = parseFloat(x.priceUsd), tvl = (x.liquidity && x.liquidity.usd) || 0;
                    if (x.chainId === 'bsc' && x.baseToken && String(x.baseToken.address).toLowerCase() === k && usd > 0 && isFinite(usd) && tvl > 0 && (!best || tvl > best.tvl))
                        best = { usd, tvl, dex: String(x.dexId || 'dex').toUpperCase(), pair: x.pairAddress, quote: (x.quoteToken && x.quoteToken.symbol) || '?' };
                });
                return best;
            } finally { clearTimeout(to); }
        })();
        _dsMemo[k] = { t: now, p };
        p.catch(() => { delete _dsMemo[k]; });
        return p;
    }

    async function renderPoolBoxes() {
        const bsc = NETWORKS["0x38"], st = stableOf(bsc), gw = new ethers.Contract(GATEWAY, GATEWAY_ABI, readRpc("0x38"));
        const wb = { symbol: "WBNB", address: bsc.wNative, decimals: 18 };
        for (const t of bsc.tokens.filter(x => x.logo && x.ok !== false)) {
            const host = document.getElementById("side-" + t.logo); if (!host) continue;
            const lic = await gw.isLicensed(t.address).catch(() => null);
            const boxes = await Promise.all([wb, st].map(q => poolBox(t, q, lic).catch(() => null)));
            if (!poolPx[t.logo]) {   // zincirden fiyat çıkmadı → DexScreener yedeği
                const d = await dsPrice(t.address).catch(() => undefined);   // null: çift yok · undefined: istek başarısız
                if (d) { poolPx[t.logo] = { usd: d.usd, tvl: d.tvl }; boxes.splice(0, boxes.length, poolCard(t, { symbol: d.quote }, { v: d.dex, a: d.pair, tvl: d.tvl }, d.usd, lic)); }
                poolState[t.logo] = d ? 'ok' : d === null ? 'none' : 'err';
            } else poolState[t.logo] = 'ok';
            host.replaceChildren(...boxes.filter(Boolean));
        }
    }

    // Sol panel: seçili ağdaki Binance'te olmayan (zincirden fiyatlanan) tokenlar
    async function fetchRealOnChainPrices() {
        if (!document.getElementById('side-market-panels')) return;   // XGIRL bölümü kaldırıldı
        const net = NETWORKS[currentChainId], stable = stableOf(net);
        if (!stable) return;
        const rp = readRpc(currentChainId);
        const list = net.tokens.filter(t => !t.isNative && !t.bn && !t.st && t.symbol !== stable.symbol && !/^W(ETH|BNB)$/.test(t.symbol) && !t.logo && t.ok !== false);
        const res = await Promise.all(list.map(async t => [t, await onchainUsd(net, rp, t, stable)]));
        const box = document.getElementById('side-market-panels'); box.textContent = '';
        res.forEach(([t, p]) => {
            const c = sideCard(t, p, stable.symbol);
            if (t.ref) {
                const l = document.createElement('div'); l.style.cssText = 'font-size:0.7rem;text-align:center;color:#aaa;margin-top:4px;';
                l.textContent = p == null ? fmtBig(t.ref) + ' adet' : fmtBig(t.ref) + ' adet ≈ $' + fmtBig(t.ref * p);
                const a = Object.assign(document.createElement('a'), { href: 'https://bscscan.com/token/' + t.address, target: '_blank', rel: 'noopener noreferrer', textContent: ' · BscScan ↗' });
                a.style.color = 'var(--neon-gold)'; l.appendChild(a); c.appendChild(l);
            }
            box.appendChild(c);
        });
    }

    const poolPx = {}, poolState = {}; let _tickItems = [], _tickHtml = '';
    function paintTicker() {   // RSM/ASM: havuzdan fiyat gelince yazılır, gelene kadar logo + "havuz bekleniyor"
        let html = '', n = 0;
        _tickItems.forEach(({ t, p, c }) => {
            const label = t.tk || t.symbol, ico = t.logo ? `<img class="tick-ico" src="${TL(t.logo)}" data-k="${t.logo}" onerror="tlFix(this)" alt="">` : '';
            if (p == null && t.logo && poolPx[t.logo]) p = poolPx[t.logo].usd;
            if (p == null) { if (t.logo) { n++; const ps = poolState[t.logo], why = ps === 'none' ? 'havuz yok' : ps === 'err' ? 'sinyal alınamadı · yeniden deneniyor' : 'havuz okunuyor…';
                html += `<div class="ticker-item">${ico}${label}: <span style="color:#aaa">${why}</span></div>`; } return; }
            n++; const isUp = c == null || c >= 0, chg = c == null ? '' : ` (${isUp ? '+' : ''}${c.toFixed(2)}%)`;
            html += `<div class="ticker-item ${isUp ? 'up' : 'down'}">${ico}${label}: $${fmtPrice(p)}${chg}</div>`;
        });
        const out = html + html;   // iki kopya: kesintisiz kayma
        if (n && out !== _tickHtml) { _tickHtml = out; document.getElementById('global-ticker').innerHTML = out; }
    }

    // Sağ panel (Binance 24s) + üst kayan bant: tam 20 token
    async function fetchLiveMarketData() {
        try {
            const bsc = NETWORKS["0x38"], rpB = readRpc("0x38"), stB = stableOf(bsc);
            const rank = t => t.logo === 'rsm' ? 0 : t.logo === 'asm' ? 1 : 2;   // bantta önce RSM, sonra ASM
            const tk = bsc.tokens.filter(t => t.tick && t.ok !== false).sort((a, b) => rank(a) - rank(b));
            const bn = await binanceTickers(tk.filter(t => t.bn).map(t => t.bn));
            if (bn.BNBUSDT) lastBnbUsd = bn.BNBUSDT.p;
            fetchRealOnChainPrices().catch(() => {});
            renderPoolBoxes().then(paintTicker).catch(() => {});

            const mk = document.getElementById('market-list'), cards = [];
            const items = await Promise.all(tk.map(async t => {
                const b = t.bn && bn[t.bn];
                if (b) return { t, p: b.p, c: b.c };
                return { t, p: stB ? await onchainUsd(bsc, rpB, t, stB) : null, c: null };
            }));
            items.forEach(({ t, p, c }) => {
                if (p == null) return;
                const label = t.tk || t.symbol, isUp = c == null || c >= 0, cls = isUp ? "up" : "down";
                const ico = t.logo ? `<img class="tick-ico" src="${TL(t.logo)}" data-k="${t.logo}" onerror="tlFix(this)" alt="">` : "";
                const chg = c == null ? "" : ` (${isUp ? '+' : ''}${c.toFixed(2)}%)`;
                if (t.bn) {
                    const card = document.createElement('div'); card.className = 'market-card';
                    card.innerHTML = `<span class="coin-symbol">${label}/USDT</span><div style="text-align:right;"><div class="coin-price">$${fmtPrice(p)}</div><div class="${cls}" style="font-size:0.75rem;">${c == null ? '—' : (isUp ? '+' : '') + c.toFixed(2) + '%'}</div></div>`;
                    cards.push(card);
                }
            });
            if (cards.length) mk.replaceChildren(...cards);
            _tickItems = items; paintTicker();
        } catch (error) { console.error("Market Fetch Error", error); }
    }

    /* ===== HABERLER: RSM + ASM canlı bülteni (zincirden) en üstte, altında Binance haberleri ===== */
    const NTK = {
        price: "Canlı fiyat: {p} (PancakeSwap V2, zincirden)",
        pool: "Havuz likiditesi: ≈ {l} ({q})",
        nopool: "PancakeSwap V2 havuzu bulunamadı — fiyat/likidite yok",
        fdv: "Toplam arz: {s} · FDV ≈ {f}",
        tx: "Son transfer: {a} · {x}",
        notx: "Son ~{m} dakikada transfer yok",
        secHot: "⭐ RSM · ASM CANLI BÜLTEN (zincirden)",
        secProj: "PROJE DUYURULARI",
        upd: "Güncelleme"
    };
    const nt = (k, o) => tLoc(NTK[k] || k, o);
    const locale = () => ({ tr: 'tr-TR', en: 'en-GB', de: 'de-DE', it: 'it-IT', es: 'es-ES', ru: 'ru-RU', ar: 'ar', zh: 'zh-CN', ja: 'ja-JP' })[uiLang] || 'tr-TR';

    async function bnbUsd() {
        if (lastBnbUsd) return lastBnbUsd;
        const bsc = NETWORKS["0x38"], st = stableOf(bsc);
        try { const a = await new ethers.Contract(bsc.routerAddress, ROUTER_ABI, readRpc("0x38")).getAmountsOut(ethers.utils.parseUnits("1", 18), [bsc.wNative, st.address]); return parseFloat(ethers.utils.formatUnits(a[1], st.decimals)); } catch (e) { return 0; }
    }

    async function poolInfo(bsc, rp, token, st, bUsd) {
        const fac = new ethers.Contract(await new ethers.Contract(bsc.routerAddress, ROUTER_ABI, rp).factory(), FACTORY_ABI, rp);
        for (const q of [bsc.wNative, st.address]) {
            const pair = await fac.getPair(token.address, q);
            if (pair === ethers.constants.AddressZero) continue;
            const pc = new ethers.Contract(pair, PAIR_ABI, rp);
            const [r, t0] = await Promise.all([pc.getReserves(), pc.token0()]);
            const isStable = q === st.address;
            const qAmt = parseFloat(ethers.utils.formatUnits(t0.toLowerCase() === q.toLowerCase() ? r.r0 : r.r1, isStable ? st.decimals : 18));
            const usd = isStable ? qAmt : (bUsd ? qAmt * bUsd : null);
            return { qSym: isStable ? st.symbol : "WBNB", usd: usd == null ? null : usd * 2 };
        }
        return null;
    }

    // RSM ve ASM için zincirden derlenen gerçek veriler (fiyat, likidite, arz/FDV, son transferler)
    async function hotBulletins() {
        const bsc = NETWORKS["0x38"], rp = readRpc("0x38"), st = stableOf(bsc), bUsd = await bnbUsd();
        const head = await rp.getBlockNumber(), from = head - 2000;
        let mins = 15;
        try { const [hb, fb] = await Promise.all([rp.getBlock(head), rp.getBlock(from)]); mins = Math.max(1, Math.round((hb.timestamp - fb.timestamp) / 60)); } catch (e) {}
        const now = new Date().toLocaleTimeString(locale());
        const out = await Promise.all(bsc.tokens.filter(t => t.logo && t.ok !== false).map(async t => {
            const cards = [], lbl = t.tk || t.symbol;
            const [price, pool, sup, logs] = await Promise.all([
                onchainUsd(bsc, rp, t, st).catch(() => null),
                poolInfo(bsc, rp, t, st, bUsd).catch(() => null),
                new ethers.Contract(t.address, ERC20_ABI, rp).totalSupply().catch(() => null),
                rp.getLogs({ address: t.address, topics: [TRANSFER_TOPIC], fromBlock: from, toBlock: head }).catch(() => null)
            ]);
            const mk = (time, title, url) => cards.push({ hot: true, logo: t.logo, time: lbl + " · " + time, title, url });
            if (price != null) mk(now, nt('price', { p: "$" + fmtPrice(price) }));
            if (pool) mk(now, nt('pool', { l: pool.usd == null ? "n/a" : "$" + fmtBig(pool.usd), q: pool.qSym }));
            else mk(now, nt('nopool'));
            if (sup) { const s = parseFloat(ethers.utils.formatUnits(sup, t.decimals)); mk(now, nt('fdv', { s: fmtBig(s), f: price == null ? "n/a" : "$" + fmtBig(price * s) })); }
            if (logs) {
                const tr = logs.filter(l => l.topics.length === 3).slice(-2).reverse();
                if (!tr.length) mk(now, nt('notx', { m: mins }));
                for (const l of tr) {
                    const blk = await rp.getBlock(l.blockNumber).catch(() => null);
                    const amt = parseFloat(ethers.utils.formatUnits(ethers.BigNumber.from(l.data), t.decimals));
                    mk(blk ? new Date(blk.timestamp * 1000).toLocaleString(locale()) : "#" + l.blockNumber,
                       nt('tx', { a: fmtBig(amt) + " " + lbl, x: shortAddr("0x" + l.topics[1].slice(26)) + " → " + shortAddr("0x" + l.topics[2].slice(26)) }), "https://bscscan.com/tx/" + l.transactionHash);
                }
            }
            return cards;
        }));
        return out.flat();
    }

    async function projectNews() {
        if (!PROJECT_NEWS_URL) return [];
        try {
            const j = await (await fetch(PROJECT_NEWS_URL, { cache: "no-store" })).json();
            return (Array.isArray(j) ? j : []).slice(0, 5).map(n => ({ hot: true, time: String(n.time || ""), title: String(n.title || ""), url: /^https:\/\//i.test(n.url || "") ? n.url : "" }));
        } catch (e) { return []; }
    }

    /* ===== ZİNCİR BÜLTENİ (RSM/ASM) — Binance haberi yok; veri tamamen zincirden ===== */
    function renderNews() {
        const box = document.getElementById('news-list'); if (!box) return;
        box.textContent = '';
        const sec = txt => { const d = document.createElement('div'); d.className = 'news-sec'; d.textContent = txt; box.appendChild(d); };
        const card = n => {
            const c = document.createElement('div'); c.className = 'news-card' + (n.hot ? ' hot' : '');
            const wrap = n.url ? Object.assign(document.createElement('a'), { href: n.url, target: '_blank', rel: 'noopener noreferrer' }) : c;
            const tm = document.createElement('span'); tm.className = 'news-time';
            if (n.logo) { const im = document.createElement('img'); im.src = TL(n.logo); im.dataset.k = n.logo; im.onerror = () => tlFix(im); im.className = 'tick-ico'; tm.appendChild(im); }
            tm.appendChild(document.createTextNode(n.time || ''));
            const ti = document.createElement('span'); ti.className = 'news-title'; ti.textContent = n.title;
            wrap.appendChild(tm); wrap.appendChild(document.createElement('br')); wrap.appendChild(ti);
            if (wrap !== c) c.appendChild(wrap);
            box.appendChild(c);
        };
        if (newsData.hot.length) { sec(nt('secHot')); newsData.hot.forEach(card); }
        if (newsData.proj.length) { sec(nt('secProj')); newsData.proj.forEach(card); }
        const st = document.getElementById('news-stamp');
        if (st) st.textContent = newsData.stamp ? nt('upd') + ': ' + newsData.stamp.toLocaleTimeString(locale()) : '';
    }

    async function refreshNews() {
        const [hot, proj] = await Promise.all([hotBulletins().catch(() => []), projectNews()]);
        newsData = { hot, proj, bin: [], src: "", stamp: new Date() };
        renderNews();
    }

    /* ===== Resmî BscScan sayfaları (logo tıklanınca) ===== */
    const OFFICIAL = {
        rsm: "https://bscscan.com/token/0xf394A750c47DfeEb134C4CbE05AAe13199e88e4e",
        asm: "https://bscscan.com/token/0xE06f8438E12DCE6328eDD94982c7B0882C5A9Cf7"
    };
    function drawChips(tab) {
        const list = (NETWORKS[currentChainId] || { tokens: [] }).tokens;
        ['from', 'to'].forEach(side => {
            const sel = document.getElementById(`${tab}-${side}-token`), img = document.getElementById(`${tab}-${side}-logo`);
            if (!sel || !img) return;
            const t = list.find(x => x.symbol === sel.value);
            if (t && t.logo) {
                img.dataset.k = t.logo; img.onerror = () => tlFix(img); img.src = TL(t.logo); img.style.display = 'inline-block';
                img.title = t.symbol + ' · BscScan';
                img.onclick = () => window.open(OFFICIAL[t.logo], '_blank', 'noopener,noreferrer');
            } else if (t) {
                img.onerror = () => { img.onerror = null; img.src = lgBadge(t.symbol); };
                img.src = lgGet(t); img.style.display = 'inline-block'; img.title = t.symbol;
                const ex = (LGC[currentChainId] || LGC['0x38']).ex;
                img.onclick = t.isNative ? null : () => window.open(ex + t.address, '_blank', 'noopener,noreferrer');
            } else { img.removeAttribute('src'); img.style.display = 'none'; img.onclick = null; }
        });
    }
    function drawAllChips() { ['main', 'btc', 'eth'].forEach(drawChips); }

    /* ===== ADRESLE TOKEN EKLE (sembol/ondalık zincirden okunur; sembol temizlenir, çakışırsa adres eki alır) ===== */
    /* ===== Token listem: manuel ekle / sil (bu tarayıcıda saklanır) ===== */
    const ctkKey = () => 'ctk:' + currentChainId;
    function ctkSave(net) { try { localStorage.setItem(ctkKey(), JSON.stringify(net.tokens.filter(t => t.custom).map(t => ({ symbol: t.symbol, address: t.address, decimals: t.decimals })))); } catch (e) {} }
    function ctkLoad(net) {
        let a = []; try { a = JSON.parse(localStorage.getItem(ctkKey())) || []; } catch (e) {}
        a.forEach(x => { try {
            const ad = ethers.utils.getAddress(x.address);
            if (!net.tokens.some(t => t.address.toLowerCase() === ad.toLowerCase())) net.tokens.push({ symbol: String(x.symbol).slice(0, 20), address: ad, decimals: Number(x.decimals) || 18, isNative: false, ok: true, custom: true });
        } catch (e) {} });
        ctkRender(net);
    }
    function ctkRender(net) {
        const box = document.getElementById('custom-token-list'); if (!box) return;
        box.textContent = '';
        let ex = 'https://bscscan.com/token/'; try { ex = (LGC[currentChainId] || LGC['0x38']).ex; } catch (e) {}
        const list = (net || NETWORKS[currentChainId]).tokens.filter(t => t.custom);
        if (!list.length) { const e = document.createElement('div'); e.className = 'hint'; e.style.cssText = 'font-size:12px;color:#777'; e.textContent = 'Henüz eklenen token yok.'; box.appendChild(e); return; }
        list.forEach(t => {
            const r = document.createElement('div'); r.className = 'tk-chip';
            const s = document.createElement('b'); s.textContent = t.symbol;
            const a = Object.assign(document.createElement('a'), { href: ex + t.address, target: '_blank', rel: 'noopener noreferrer', textContent: shortAddr(t.address) });
            const x = document.createElement('button'); x.className = 'tk-del'; x.title = 'Listeden sil'; x.textContent = '✕'; x.onclick = () => ctkDel(t.address);
            r.append(s, a, x); box.appendChild(r);
        });
    }
    function ctkDel(addr) {
        const net = NETWORKS[currentChainId], i = net.tokens.findIndex(t => t.custom && t.address.toLowerCase() === addr.toLowerCase());
        if (i < 0) return;
        const sym = net.tokens[i].symbol; net.tokens.splice(i, 1); ctkSave(net);
        populateTokenDropdowns(); drawAllChips();
        try { if (arbOk()) arbRefresh(); } catch (e) {}
        const m = document.getElementById('custom-token-msg'); if (m) m.textContent = sym + ' listeden silindi.';
    }

    async function addCustomToken() {
        const inp = document.getElementById('custom-token-addr'), msg = document.getElementById('custom-token-msg');
        const net = NETWORKS[currentChainId];
        try {
            const addr = ethers.utils.getAddress(inp.value.trim());
            if (net.tokens.some(t => t.address.toLowerCase() === addr.toLowerCase())) { msg.textContent = 'Bu token listede zaten var.'; tkShow('custom-token-card', currentChainId, addr); return; }
            const c = new ethers.Contract(addr, ERC20_ABI, readRpc(currentChainId));
            const [sym, dec] = await Promise.all([c.symbol(), c.decimals()]);
            let symbol = String(sym).replace(/[^A-Za-z0-9._+\- ]/g, '').trim().slice(0, 20) || 'TOKEN';
            if (net.tokens.some(t => t.symbol === symbol)) symbol += '·' + addr.slice(2, 6);
            net.tokens.push({ symbol, address: addr, decimals: Number(dec), isNative: false, ok: true, custom: true }); ctkSave(net);
            populateTokenDropdowns();
            tkShow('custom-token-card', currentChainId, addr); drawAllChips(); try { if (arbOk()) arbRefresh(); } catch (e) {}
            msg.textContent = symbol + ' eklendi. Takas öncesi adresi BscScan\'de kendiniz doğrulayın.';
            inp.value = '';
        } catch (e) { msg.textContent = 'Geçersiz adres veya ERC-20 kontratı okunamadı.'; }
    }

    /* ===== YEREL TV ===== */
    // src: yalnız hak sahibinin verdiği https .m3u8 adresi. Boş = yayın oynatılmaz, resmî canlı sayfa bağlantısı gösterilir.
    const TV_CHANNELS = [
        { id: "show",   name: "Show TV", page: "https://www.showtv.com.tr/",                           src: "" },
        { id: "kanald", name: "Kanal D", page: "https://www.kanald.com.tr/", src: "" },
        { id: "trt1",   name: "TRT 1",   page: "https://www.trt1.com.tr/",   src: "" },
        { id: "star",   name: "Star TV", page: "https://www.startv.com.tr/", src: "" }
    ];
    let tvHls = null, tvActive = null;
    function tvInit() { tvPlay(TV_CHANNELS[0]); }
    function tvRenderTabs() {
        const box = document.getElementById('tv-tabs'); if (!box) return;
        box.textContent = '';
        TV_CHANNELS.forEach(ch => {
            const b = document.createElement('button');
            b.className = 'tv-tab' + (tvActive === ch ? ' on' : '');
            b.textContent = ch.name;
            b.onclick = () => tvPlay(ch);
            box.appendChild(b);
        });
    }
    function tvLabels() { const a = document.getElementById('tv-open'); if (a) a.textContent = tLoc('Resmî canlı sayfayı aç ↗'); }
    function tvPlay(ch) {
        tvActive = ch; tvRenderTabs();
        const v = document.getElementById('tv-player'), note = document.getElementById('tv-note'), open = document.getElementById('tv-open');
        if (tvHls) { tvHls.destroy(); tvHls = null; }
        v.pause(); v.removeAttribute('src'); v.load();
        open.href = ch.page || '#';
        open.style.display = ch.page ? 'inline-block' : 'none';
        tvLabels();
        const ok = /^https:\/\/[^\s]+\.m3u8(\?[^\s]*)?$/i.test(ch.src || '');
        if (!ok) {
            v.style.display = 'none';
            note.textContent = ch.page ? tLoc('Bu kanal için yayın kaynağı tanımlı değil. Resmî canlı yayını yukarıdaki bağlantıdan izleyin.') : tLoc('Resmî sayfa adresi girilmedi');
            note.style.display = 'block';
            return;
        }
        v.style.display = 'block'; note.style.display = 'none';
        if (window.Hls && Hls.isSupported()) { tvHls = new Hls({ capLevelToPlayerSize: false }); tvHls.loadSource(ch.src); tvHls.attachMedia(v); }
        else if (v.canPlayType('application/vnd.apple.mpegurl')) v.src = ch.src;
        else { note.textContent = tLoc('Tarayıcı HLS desteklemiyor.'); note.style.display = 'block'; }
    }

    /* ===== ARBİTRAJ: yalnız sözleşmenin owner'ı görür ve çalıştırır (flash-loan: borç al → çevir → öde) ===== */
    const ARB_CONTRACT = "0x1ae32e13c4532D251DcDf09D172610f63a4E75B8";
    const ARB_ROUTERS = [
        { n: "PancakeSwap", r: "0x10ED43C718714eb63d5aA57B78B54704E256024E" },
        { n: "ApeSwap",     r: "0xcF0feBd3f17CEf5b47b0cD257aCf6025c5BFf3b7" },
        { n: "Biswap",      r: "0x3a6d8cA21D1CF76F653A67577FA0D27453350dD8" }
    ];
    const AAVE_PREMIUM_BPS = 5;   // Aave V3 flash-loan primi ~0,05%; gerçek tutarı sözleşme hesaplar
    const ARB_ABI = [
        {"type":"function","name":"OWNER","stateMutability":"view","inputs":[],"outputs":[{"name":"","type":"address"}]},
        {"type":"function","name":"owner","stateMutability":"view","inputs":[],"outputs":[{"name":"","type":"address"}]},
        {"type":"function","name":"requestFlashLoan","stateMutability":"nonpayable","inputs":[
            {"name":"asset","type":"address"},
            {"name":"amount","type":"uint256"},
            {"name":"steps","type":"tuple[]","components":[
                {"name":"router","type":"address"},
                {"name":"path","type":"address[]"},
                {"name":"minAmountOut","type":"uint256"},
                {"name":"kind","type":"uint8"},
                {"name":"fee","type":"uint24"}]},
            {"name":"minProfit","type":"uint256"},
            {"name":"deadline","type":"uint256"}],"outputs":[]}
    ];
    let arbBest = null, arbOwnerFor = null, isArbOwner = false, isArbOp = false;
    const arbOk = () => isArbOwner || isArbOp;   // owner veya owner'ın yetkilendirdiği cüzdan
    function arbHide() {   // yetkisiz cüzdanda kontrol sekmesi ve penceresi kapanır
        const b = document.getElementById('tab-btn-arb'), t = document.getElementById('tab-arb');
        if (b) b.classList.add('hidden');
        if (t && t.classList.contains('active')) { t.classList.remove('active'); const m = document.getElementById('tab-btn-main'); if (m) m.click(); }
    }
    const escH = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    async function refreshOwnerUI() {
        const btn = document.getElementById('tab-btn-arb');
        if (!userAddress) { isArbOwner = isArbOp = false; arbOwnerFor = null; arbHide(); return; }
        if (arbOwnerFor === userAddress) return;
        arbOwnerFor = userAddress;
        try {
            const ac = new ethers.Contract(ARB_CONTRACT, ARB_ABI, readRpc("0x38")); const o = await ac.OWNER().catch(() => ac.owner());
            isArbOwner = o.toLowerCase() === userAddress.toLowerCase();
            isArbOp = !isArbOwner && await new ethers.Contract(ARB_CONTRACT, ['function operators(address) view returns (bool)'], readRpc("0x38")).operators(userAddress).catch(() => false);
        } catch (e) { isArbOwner = isArbOp = false; }
        if (arbOk()) { if (btn) btn.classList.remove('hidden'); } else arbHide();
        if (arbOk()) arbRefresh();
        if (isArbOwner) auBotAuto();
    }
    function arbRefresh() {
        const net = NETWORKS["0x38"], sel = document.getElementById('arb-tesla');
        document.getElementById('arb-addr').textContent = shortAddr(ARB_CONTRACT);
        const list = net.tokens.filter(t => !t.isNative && t.ok !== false && t.symbol !== 'USDC').sort((a, b) => (a.logo ? 0 : 1) - (b.logo ? 0 : 1));
        const keep = sel.value;
        sel.innerHTML = list.map(t => `<option value="${t.symbol}">${t.symbol}</option>`).join('') || '<option value="">—</option>';
        if (list.some(t => t.symbol === keep)) sel.value = keep;
        try { auRefresh(); } catch (e) {}
        if (!window._auFilled) { window._auFilled = 1; auFillUsd(); }
        arbScan();
    }

    async function arbScan() {
        arbBest = null;
        const fire = document.getElementById('arb-fire'), rt = document.getElementById('arb-route'), pr = document.getElementById('arb-profit');
        fire.disabled = true; rt.textContent = '—'; pr.textContent = '—';
        if (!arbOk()) return;
        try {
            const net = NETWORKS["0x38"], rp = readRpc("0x38");
            const A = net.tokens.find(t => t.symbol === document.getElementById('arb-asset').value);
            const T = net.tokens.find(t => t.symbol === document.getElementById('arb-tesla').value);
            if (!A || !T || A.ok === false || T.ok === false) return;
            if (A.symbol === T.symbol) { rt.textContent = 'Hedef token, borç varlığından farklı olmalı'; return; }
            if (pending(A) || pending(T)) { rt.textContent = tLoc('Token doğrulanıyor...'); return; }
            const amtRaw = (document.getElementById('arb-amount').value || '0').trim();
            if (!(Number(amtRaw) > 0)) return;
            const amt = ethers.utils.parseUnits(amtRaw, A.decimals);
            const minP = ethers.utils.parseUnits((document.getElementById('arb-minprofit').value || '0').trim(), A.decimals);
            const prem = amt.mul(AAVE_PREMIUM_BPS).div(10000), need = amt.add(prem);
            const fwd = await Promise.all(ARB_ROUTERS.map(R =>
                new ethers.Contract(R.r, ROUTER_ABI, rp).getAmountsOut(amt, [A.address, T.address]).then(x => x[1]).catch(() => null)));
            const pairs = [];
            for (let i = 0; i < ARB_ROUTERS.length; i++) for (let j = 0; j < ARB_ROUTERS.length; j++) {
                if (i !== j && fwd[i] && !fwd[i].isZero()) pairs.push({ i, j, out1: fwd[i] });
            }
            const res = await Promise.all(pairs.map(p =>
                new ethers.Contract(ARB_ROUTERS[p.j].r, ROUTER_ABI, rp).getAmountsOut(p.out1, [T.address, A.address])
                    .then(x => ({ ...p, out2: x[1] })).catch(() => null)));
            let best = null;
            for (const r of res) if (r && (!best || r.out2.gt(best.out2))) best = r;
            if (!best) { rt.textContent = tLoc('Likidite Yetersiz'); return; }
            rt.textContent = `${ARB_ROUTERS[best.i].n} → ${T.symbol} → ${ARB_ROUTERS[best.j].n}`;
            const ok = best.out2.gt(need.add(minP));
            pr.textContent = best.out2.gt(need) ? ethers.utils.formatUnits(best.out2.sub(need), A.decimals) + ' ' + A.symbol : '—';
            if (!ok) pr.textContent += ' · ' + tLoc('Fırsat yok: net kâr eşiğin altında. İşlem gönderilmedi.');
            arbBest = { ...best, amt, prem, need, minP, A, T, addrA: A.address, addrT: T.address, ok };
            fire.disabled = !ok;
        } catch (e) { rt.textContent = tLoc('Hata') + ': ' + (e.reason || e.message || e); }
    }

    /* Arbitraj durum rozeti: tarama sonucunu tek bakışta gösterir */
    function arbBadge(s) {
        const b = document.getElementById('arb-badge'); if (!b) return;
        const m = { scan: ['TARANIYOR…', ''], ok: ['✅ FIRSAT VAR', 'ok'], no: ['⏸ FIRSAT YOK', 'no'], idle: ['—', ''] }[s];
        b.textContent = m[0]; b.className = 'arb-badge ' + m[1];
    }
    const _arbScanRaw = arbScan;
    arbScan = async function () { arbBadge('scan'); try { await _arbScanRaw(); } finally { arbBadge(arbBest ? (arbBest.ok ? 'ok' : 'no') : 'idle'); } };

    function confirmBox(title, text, rows) {
        return new Promise(res => {
            document.getElementById('ntc-title').textContent = title;
            document.getElementById('ntc-text').textContent = text;
            document.getElementById('ntc-rows').innerHTML = rows.map(r => `<div class="ntc-row"><b>${escH(r[0])}</b><span>${escH(r[1])}</span></div>`).join('');
            document.getElementById('ntc-ok').textContent = tLoc('Cüzdanda onayla');
            document.getElementById('ntc-no').textContent = tLoc('Vazgeç');
            const box = document.getElementById('notice'); box.classList.remove('hidden');
            const done = v => { box.classList.add('hidden'); res(v); };
            document.getElementById('ntc-ok').onclick = () => done(true);
            document.getElementById('ntc-no').onclick = () => done(false);
        });
    }

    async function arbFire() {
        try {
            if (!arbOk()) throw new Error(tLoc('Kontrol bölümü yalnızca owner ve owner’ın yetki verdiği cüzdanlarda açılır.'));
            if (!arbBest || !arbBest.ok) throw new Error(tLoc('Fırsat yok: net kâr eşiğin altında. İşlem gönderilmedi.'));
            await ensureChain();
            const b = arbBest, slip = Math.floor((100 - slippagePercent) * 10);   // binde
            const steps = [
                { router: ARB_ROUTERS[b.i].r, path: [b.addrA, b.addrT], minAmountOut: b.out1.mul(slip).div(1000), kind: 0, fee: 0 },
                { router: ARB_ROUTERS[b.j].r, path: [b.addrT, b.addrA], minAmountOut: b.out2.mul(slip).div(1000), kind: 0, fee: 0 }
            ];
            const arb = new ethers.Contract(ARB_CONTRACT, ARB_ABI, signer);
            const deadline = Math.floor(Date.now() / 1000) + 120;
            const args = [b.addrA, b.amt, steps, b.minP, deadline];
            // ön simülasyon: revert olursa cüzdan açılmaz, gaz harcanmaz
            const gas = await arb.estimateGas.requestFlashLoan(...args);
            const gasA = await arbGasInAsset(b.addrA, gas.mul(await provider.getGasPrice()));
            if (!gasA || b.out2.sub(b.need).lte(gasA.mul(110).div(100))) throw new Error(tLoc('Net kâr gazı karşılamıyor, gönderilmedi'));
            const ok = await confirmBox(tLoc('Cüzdan onayı gerekli'),
                tLoc('Devam edince cüzdanınız (🦊) onay isteyecek. Ağın BNB Smart Chain (56) olduğunu; sözleşme, token ve tutarın aşağıdakilerle aynı olduğunu kontrol edin.'),
                [[tLoc('Sözleşme'), shortAddr(ARB_CONTRACT)],
                 [tLoc('Tutar'), ethers.utils.formatUnits(b.amt, b.A.decimals) + ' ' + b.A.symbol],
                 [tLoc('Tahmini gas'), gas.toString()]]);
            if (!ok) return;
            showToast(tLoc('Cüzdanda onay bekleniyor…'), 'info');
            const tx1 = await arb.requestFlashLoan(...args, { gasLimit: gas.mul(115).div(100) });
            showToast(tLoc('Gönderildi') + ': ' + tx1.hash.substring(0, 12) + '…', 'info');
            const rc = await tx1.wait();
            showToast(tLoc('Zincirde onaylandı') + ' (' + rc.blockNumber + ')', 'success');
            arbScan();
        } catch (e) { showToast(tLoc('Hata') + ': ' + (e.reason || e.message || e), 'error'); }
    }
    const LANGS = ['tr', 'en', 'de', 'it', 'es', 'ru', 'ar', 'zh', 'ja'];
