    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Orbitron:wght@400;600;800;900&display=swap');
        
        :root {
            --gold: #D4A017; 
            --neon-gold: #ffc83b; 
            --bg-dark: #050507;
            --panel-bg: rgba(12, 12, 15, 0.94); 
            --cyber-green: #00ff9d;
            --cyber-red: #ff3366; 
            --input-bg: #09090d;
            --side-panel-width: 280px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body { 
            background: radial-gradient(circle at 50% 30%, #1a1205 0%, var(--bg-dark) 85%); 
            color: var(--gold); 
            font-family: 'Cinzel', serif;
            min-height: 100vh; 
            overflow-x: hidden;
        }

        body::before {
            content: ""; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(212, 160, 23, 0.03) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(212, 160, 23, 0.03) 1px, transparent 1px);
            background-size: 32px 32px; pointer-events: none; z-index: 0;
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #050505; }
        ::-webkit-scrollbar-thumb { background: rgba(212, 160, 23, 0.4); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--gold); }

        .yan-panel {
            position: fixed; top: 45px; left: 0; width: var(--side-panel-width);
            height: calc(100vh - 45px); background-color: rgba(6, 6, 8, 0.96);
            border-right: 1px solid rgba(212, 160, 23, 0.3); padding: 20px 15px;
            display: flex; flex-direction: column; gap: 16px; z-index: 90;
            overflow-y: auto; backdrop-filter: blur(12px);
        }

        .panel-resmi {
            width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--gold);
            box-shadow: 0 0 10px rgba(212, 160, 23, 0.2); transition: transform 0.3s ease;
        }
        .panel-resmi:hover { transform: scale(1.02); }
        .tk-ico { width: 18px; height: 18px; border-radius: 50%; vertical-align: middle; margin-right: 6px; box-shadow: 0 0 6px rgba(212,160,23,.5); }
        .ipfs-row, .lk-form { margin-top: 10px; font-size: 12px; }
        .ipfs-row input, .lk-form input { width: 100%; margin: 4px 0; padding: 8px; background: #0a0a0a; color: var(--gold); border: 1px solid #333; border-radius: 6px; font-size: 12px; }

        /* MetaMask bağlanınca görünen RSM rozeti */
        .wallet-badge {
            display: none; align-items: center; gap: 14px; margin: -6px 0 22px; padding: 12px 14px;
            background: rgba(0,0,0,0.7); border: 1px solid rgba(212, 160, 23, 0.45); border-radius: 10px;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8); font-family: 'Orbitron', sans-serif;
        }
        .wallet-badge.show { display: flex; }
        .wallet-badge img { width: 64px; height: 64px; flex: none; border-radius: 50%; filter: drop-shadow(0 0 8px rgba(212,160,23,0.45)); }
        .wb-text { min-width: 0; flex: 1; }
        .wb-name { color: #fff; font-size: 0.82rem; letter-spacing: 1px; }
        .wb-addr { color: var(--cyber-green); font-size: 0.7rem; margin-top: 3px; word-break: break-all; }
        .wb-add {
            margin-top: 8px; background: transparent; color: var(--neon-gold); border: 1px solid var(--gold);
            border-radius: 6px; padding: 6px 10px; cursor: pointer; font-family: 'Orbitron', sans-serif;
            font-size: 0.68rem; letter-spacing: 1px; transition: background 0.2s;
        }
        .wb-add:hover { background: rgba(212, 160, 23, 0.15); }
.rsm-ad { display: block; position: relative; max-width: 600px; margin: 14px auto 0; border: 1px solid rgba(212,160,23,0.4); border-radius: 12px; overflow: hidden; text-decoration: none; }
.rsm-ad img { display: block; width: 100%; height: auto; }
.rsm-ad small { position: absolute; top: 6px; right: 8px; z-index: 1; font-size: 0.6rem; letter-spacing: 1px; color: #fff; background: rgba(0,0,0,0.55); padding: 2px 6px; border-radius: 6px; }
        .wb-add:focus-visible { outline: 2px solid var(--neon-gold); outline-offset: 2px; }

        /* Tüm DEX havuzları listesi */
        .alldex-row { display: block; padding: 7px 0; border-top: 1px dashed rgba(212, 160, 23, 0.22); text-decoration: none; }
        .alldex-row:first-of-type { border-top: 0; }
        .alldex-row:hover .alldex-top span { color: var(--neon-gold); }
        .alldex-top { display: flex; justify-content: space-between; gap: 8px; font-size: 0.7rem; color: #fff; }
        .alldex-top b { color: var(--cyber-green); font-weight: 700; white-space: nowrap; }
        .alldex-sub { font-size: 0.62rem; color: #aaa; margin-top: 2px; }

        .rsm-market-widget {
            background: #000; border: 1px solid rgba(212, 160, 23, 0.35);
            border-radius: 8px; padding: 12px; font-family: 'Orbitron', sans-serif;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        }
        .rsm-market-widget h4 {
            font-size: 0.78rem; color: #fff; margin-bottom: 8px; text-align: center;
            border-bottom: 1px dashed rgba(212, 160, 23, 0.3); padding-bottom: 5px; letter-spacing: 1px;
        }

        .top-bar {
            position: fixed; top: 0; left: 0; width: 100%; height: 45px;
            background: rgba(4, 4, 6, 0.98); border-bottom: 1px solid var(--gold);
            z-index: 999; display: flex; align-items: center; justify-content: space-between; overflow: hidden;
        }
        
        .live-clock {
            min-width: 180px; padding: 0 15px; font-family: 'Orbitron', sans-serif;
            color: var(--neon-gold); font-size: 0.78rem; font-weight: 700;
            border-right: 1px solid var(--gold); background: #000;
            display: flex; align-items: center; justify-content: center; height: 100%; z-index: 2;
        }

        .ticker-wrap { flex-grow: 1; height: 100%; display: flex; align-items: center; overflow: hidden; position: relative; }
        .ticker-row { display: flex; width: max-content; animation: marquee 35s linear infinite; will-change: transform; }
        .ticker-row:hover { animation-play-state: paused; }
        
        .ticker-item { 
            padding: 0 20px; font-size: 0.78rem; font-weight: 700; 
            font-family: 'Orbitron', sans-serif; display: flex; gap: 8px; 
            border-right: 1px solid rgba(212, 160, 23, 0.25); align-items: center; white-space: nowrap; 
        }
        .up { color: var(--cyber-green); text-shadow: 0 0 4px rgba(0,255,157,0.3); } 
        .down { color: var(--cyber-red); text-shadow: 0 0 4px rgba(255,51,102,0.3); } 
        .neutral { color: var(--neon-gold); }
        
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

        .lang-container, .network-container {
            padding: 0 12px; display: flex; align-items: center; 
            border-left: 1px solid var(--gold); background: #000; height: 100%; z-index: 2;
        }
        
        .lang-select, .network-select {
            background: #000; color: var(--neon-gold); border: 1px solid rgba(212, 160, 23, 0.5);
            padding: 4px 10px; border-radius: 4px; font-family: 'Orbitron', sans-serif;
            font-size: 0.78rem; font-weight: bold; outline: none; cursor: pointer;
            transition: all 0.2s;
        }
        .network-select:hover, .lang-select:hover { border-color: var(--neon-gold); box-shadow: 0 0 8px rgba(212,160,23,0.4); }

        .layout-container {
            display: grid; grid-template-columns: 1fr 380px; gap: 24px;
            max-width: 1440px; margin: 65px 20px 40px calc(var(--side-panel-width) + 20px); 
            position: relative; z-index: 1;
        }

        .main-panel { 
            background: var(--panel-bg); border: 1px solid rgba(212, 160, 23, 0.4); 
            border-radius: 16px; padding: 28px; box-shadow: 0 10px 40px rgba(0,0,0,0.9); 
            position: relative; overflow: hidden; backdrop-filter: blur(12px);
        }

        h1 { font-size: 1.8rem; color: #fff; text-align: center; margin-bottom: 4px; text-shadow: 0 0 12px rgba(212,160,23,0.6); letter-spacing: 2px;}
        h2 { font-size: 0.85rem; color: var(--gold); text-align: center; margin-bottom: 22px; font-family: 'Orbitron'; letter-spacing: 3px; }
        
        #status { 
            text-align: center; padding: 10px; background: rgba(0,0,0,0.7); 
            border-radius: 8px; color: var(--cyber-green); font-family: 'Orbitron'; 
            margin-bottom: 20px; font-size: 0.82rem; border: 1px solid rgba(212, 160, 23, 0.3);
            letter-spacing: 1px; word-break: break-all; box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        }
        
        .main-connect-btn { 
            background: linear-gradient(135deg, #b8860b, #ffc83b); color: #000; 
            border: none; padding: 14px; border-radius: 8px; cursor: pointer; 
            font-weight: 800; font-family: 'Orbitron'; width: 100%; 
            transition: all 0.3s; letter-spacing: 1px; font-size: 0.95rem; margin-bottom: 22px;
            box-shadow: 0 4px 15px rgba(212, 160, 23, 0.3);
        }
        .main-connect-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 25px rgba(212,160,23,0.6); }
        
        .tabs-container {
            display: flex; justify-content: center; gap: 8px; margin-bottom: 20px; flex-wrap: wrap;
        }
        .tab-btn {
            background: #0c0c10; border: 1px solid rgba(212, 160, 23, 0.4); color: var(--gold);
            padding: 10px 18px; border-radius: 6px; cursor: pointer;
            font-family: 'Orbitron'; font-weight: bold; font-size: 0.8rem;
            transition: all 0.3s ease; letter-spacing: 1px;
        }
        .tab-btn.active { background: var(--gold); color: #000; box-shadow: 0 0 12px rgba(212,160,23,0.5); }
        .tab-btn:hover:not(.active) { background: rgba(212, 160, 23, 0.2); border-color: var(--neon-gold); }

        .swap-container {
            background: rgba(6, 6, 10, 0.8); border: 1px solid rgba(212, 160, 23, 0.25);
            border-radius: 12px; padding: 22px; box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
            display: none;
        }
        .swap-container.active { display: block; }

        .swap-box-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .swap-box-header h3 { color: #fff; font-family: 'Orbitron'; font-size: 0.95rem; letter-spacing: 1px; }

        .token-input-row {
            background: var(--input-bg); border: 1px solid #1f1f2e; border-radius: 10px;
            padding: 14px; margin-bottom: 10px; transition: border-color 0.3s;
        }
        .token-input-row:focus-within { border-color: var(--gold); box-shadow: 0 0 10px rgba(212,160,23,0.2); }

        .input-top { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.75rem; color: #999; font-family: 'Orbitron'; }
        .input-bottom { display: flex; gap: 12px; align-items: center; }

        .input-bottom input {
            flex: 1; background: transparent; border: none; color: #fff;
            font-family: 'Orbitron'; font-size: 1.4rem; outline: none; width: 60%; font-weight: 700;
        }
        
        .token-select {
            background: #000; color: var(--neon-gold); border: 1px solid rgba(212, 160, 23, 0.4);
            padding: 8px 12px; border-radius: 6px; font-family: 'Orbitron';
            font-size: 0.88rem; font-weight: bold; outline: none; cursor: pointer;
            display: flex; align-items: center; gap: 6px; max-width: 170px;
        }

        .switch-btn-row { text-align: center; margin: -6px 0 6px 0; }
        .switch-btn {
            background: #111; border: 1px solid var(--gold); color: var(--gold);
            width: 36px; height: 36px; border-radius: 50%; cursor: pointer;
            font-size: 1.1rem; transition: all 0.3s; font-family: 'Orbitron'; display: inline-flex;
            align-items: center; justify-content: center; box-shadow: 0 0 10px rgba(0,0,0,0.8);
        }
        .switch-btn:hover { background: var(--gold); color: #000; transform: rotate(180deg); }

        .tag { 
            font-size: 0.68rem; padding: 4px 8px; border-radius: 4px; 
            background: rgba(0,255,157,0.1); color: var(--cyber-green); 
            border: 1px solid var(--cyber-green); font-family: 'Orbitron'; 
        }
        
        .info-row { display: flex; justify-content: space-between; margin-top: 12px; font-family: 'Orbitron'; font-size: 0.78rem; color: #aaa; }
        .highlight { color: var(--neon-gold); font-weight: bold; }
        
        .slippage-box { display: flex; justify-content: space-between; margin-top: 14px; font-family: 'Orbitron'; font-size: 0.78rem; align-items: center; }
        .slippage-opts { display: flex; gap: 6px; }
        .slip-btn { 
            background: #0c0c10; color: #888; border: 1px solid #222; 
            padding: 4px 10px; border-radius: 4px; cursor: pointer; 
            font-family: 'Orbitron'; font-size: 0.72rem; transition: 0.2s;
        }
        .slip-btn.active { background: rgba(212, 160, 23, 0.25); color: var(--gold); border-color: var(--gold); }

        .action-btn-group { display: flex; gap: 10px; margin-top: 18px; }
        .action-btn {
            flex: 1; padding: 14px; border-radius: 8px;
            font-family: 'Orbitron'; font-weight: 800; font-size: 0.92rem; border: none;
            cursor: pointer; transition: all 0.3s ease; letter-spacing: 1px;
            text-align: center;
        }
        .btn-action-swap { background: linear-gradient(135deg, #00b36c, var(--cyber-green)); color: #000; box-shadow: 0 4px 15px rgba(0,255,157,0.2); }
        .btn-action-approve { background: linear-gradient(135deg, #b8860b, var(--neon-gold)); color: #000; box-shadow: 0 4px 15px rgba(212,160,23,0.3); }
        .action-btn:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
        .action-btn:hover:not(:disabled) { transform: translateY(-2px); opacity: 0.95; }

        .right-panel { display: flex; flex-direction: column; gap: 18px; }
        
        .market-container, .news-container { 
            background: #060608; border: 1px solid rgba(212, 160, 23, 0.3); 
            border-radius: 12px; padding: 16px; display: flex; flex-direction: column;
            backdrop-filter: blur(10px);
        }
        .market-container { height: 320px; }
        .news-container { flex-grow: 1; min-height: 250px; }
        
        .market-container h3, .news-container h3 { font-family: 'Orbitron'; font-size: 0.88rem; color: #fff; margin-bottom: 12px; text-align: center; letter-spacing: 1px; }
        
        .market-list, .news-list { display: flex; flex-direction: column; gap: 8px; overflow-y: auto; flex-grow: 1; padding-right: 4px; }
        .market-card { background: #0c0c10; border: 1px solid #1a1a24; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; }
        
        .news-card { 
            background: #08080c; border-left: 3px solid var(--cyber-green); border-top: 1px solid #14141d;
            border-right: 1px solid #14141d; border-bottom: 1px solid #14141d;
            border-radius: 4px; padding: 10px; display: flex; flex-direction: column; gap: 4px;
            transition: all 0.2s;
        }
        .news-card:hover { border-left-color: var(--gold); background: #0d0d14; }
        .news-time { font-family: 'Orbitron'; font-size: 0.65rem; color: var(--neon-gold); }
        .news-title { font-size: 0.78rem; color: #eee; font-weight: bold; line-height: 1.3; font-family: 'Orbitron'; }
        
        .coin-symbol { font-family: 'Orbitron'; font-weight: 700; color: var(--gold); font-size: 0.85rem; }
        .coin-price { font-family: 'Orbitron'; font-weight: 700; color: #fff; font-size: 0.82rem; }

        #toast-container {
            position: fixed; bottom: 20px; right: 20px; z-index: 99999;
            display: flex; flex-direction: column; gap: 10px; max-width: 360px;
        }
        .toast {
            background: #0a0a0f; border: 1px solid var(--gold); color: #fff;
            padding: 12px 16px; border-radius: 8px; font-family: 'Orbitron'; font-size: 0.8rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.9); display: flex; align-items: center; justify-content: space-between;
            animation: slideIn 0.3s ease-out;
        }
        .toast-success { border-color: var(--cyber-green); color: var(--cyber-green); }
        .toast-error { border-color: var(--cyber-red); color: var(--cyber-red); }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

        @media (max-width: 1100px) { 
            .yan-panel { position: relative; width: 100%; height: auto; top: 0; border-right: none; border-bottom: 1px solid var(--gold); }
            .layout-container { grid-template-columns: 1fr; margin-left: 20px; margin-top: 20px; } 
            .top-bar { flex-direction: column; height: auto; }
            .live-clock, .lang-container, .network-container { width: 100%; justify-content: center; }
        }
    
        .tick-ico { width: 18px; height: 18px; border-radius: 50%; vertical-align: middle; margin-right: 6px; }
        .news-card.hot { border-left-color: var(--gold); background: #0d0b04; }
        .news-card a { color: inherit; text-decoration: none; display: block; }
        .news-card a:hover .news-title { color: var(--gold); }
        .news-sec { font-family: 'Orbitron'; font-size: 0.68rem; letter-spacing: 1px; color: var(--gold); margin: 8px 0 2px; }
        .news-stamp { font-size: 0.62rem; color: #888; text-align: center; margin: -6px 0 8px; }

        .hidden { display: none !important; }
        .tok-chip { width: 22px; height: 22px; border-radius: 50%; vertical-align: middle; margin-left: 6px; display: none; cursor: pointer; border: 1px solid #2a3a66; }
        .tv-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; }
        .tv-tab { background: #0b1a38; border: 1px solid #2a3a66; color: #cfe0ff; border-radius: 8px; padding: 6px 10px; font-size: 12px; cursor: pointer; }
        .tv-tab.on { border-color: #d4a017; color: #ffd166; }
        .tv-title { font-family: 'Orbitron'; font-size: 0.8rem; color: #fff; margin: 0 0 6px; letter-spacing: 1px; }
        .tv-open { display: none; margin-top: 8px; font-size: 12px; color: #ffd166; text-decoration: none; }
        .notice { position: fixed; inset: 0; z-index: 120; background: #000c; display: grid; place-items: center; padding: 16px; }
        .notice .box { max-width: 460px; width: 100%; background: #10183a; border: 1px solid #d4a017; border-radius: 16px; padding: 20px; color: #e6edff; }
        .notice .box h3 { margin: 0 0 8px; }
        .ntc-row { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid #1e293b; font-size: 12px; }
        .ntc-row span { word-break: break-all; text-align: end; color: #fff; }

        /* Dönen altın çember: üstteki halka katmanı döner, alttaki tam logo sabit kalır */
        .spin-wrap { position: relative; display: block; width: 100%; }
        .spin-wrap > img:first-child { display: block; width: 100%; height: auto; border: 0; border-radius: 50%; box-shadow: 0 0 16px rgba(212,160,23,.35); transform: none !important; }
        .spin-ring { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; animation: ringSpin 14s linear infinite; will-change: transform; }
        @keyframes ringSpin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) { .spin-ring { animation: none; } }
        .reg-row { font-family: 'Orbitron', sans-serif; font-size: .68rem; line-height: 1.55; color: #cfcfcf; word-break: break-all; }
        .reg-ok { color: var(--cyber-green); } .reg-bad { color: var(--cyber-red); }
    
.tk-manage{margin-top:12px;border:1px solid rgba(255,209,102,.22);border-radius:12px;padding:10px 12px;background:rgba(0,0,0,.22)}
.tk-manage-h{font-size:.78rem;letter-spacing:1px;color:#ffd166}.tk-manage-h small{color:#aaa;letter-spacing:0;margin-left:6px}
.tk-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.tk-chip{display:flex;align-items:center;gap:6px;padding:4px 8px;border-radius:999px;background:rgba(255,255,255,.07);font-size:.72rem}
.tk-chip a{color:#aaa;text-decoration:none}
.tk-del{border:0;background:#4a1515;color:#ff8080;border-radius:50%;width:20px;height:20px;cursor:pointer;line-height:1;padding:0}
.arb-card{border:1px solid rgba(255,209,102,.25);border-radius:12px;padding:10px 12px;margin:10px 0;background:rgba(0,0,0,.25)}
.arb-card h4{margin:0 0 8px;font-size:.78rem;letter-spacing:1px;color:#ffd166;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.arb-card h4 small{font-size:.68rem;letter-spacing:0;color:#aaa;font-weight:400}
.arb-note{margin-top:8px;font-size:12px;color:#aaa}
.arb-badge{font-size:.68rem;padding:2px 10px;border-radius:999px;background:#2b2b2b;color:#aaa;letter-spacing:0}
.arb-badge.ok{background:#0b3d1d;color:#3dff8f}.arb-badge.no{background:#3d2a0b;color:#ffb347}
#at-logopkg{border:1px solid rgba(255,209,102,.25);border-radius:12px;padding:8px 12px;margin:10px 0;background:rgba(0,0,0,.25)}#at-logopkg:empty{display:none}
.lp-h{display:flex;justify-content:space-between;align-items:center;font-size:.78rem;letter-spacing:1px;color:#ffd166;margin-bottom:6px}
.lp-copy{flex:0 0 auto;min-width:0;padding:4px 10px}
.lp-row{font-family:monospace;font-size:.72rem;color:#ddd;word-break:break-all;padding:2px 0;border-bottom:1px dashed rgba(255,255,255,.07)}.lp-row a{color:var(--neon-gold,#ffd166)}

.lk3{display:flex;flex-direction:column;gap:4px;margin:4px 0 8px}.lk3-row{display:flex;flex-wrap:wrap;gap:4px 14px;align-items:center;font-size:.72rem}
.lk3-it{display:inline-flex;align-items:center;gap:4px}.lk3-it a{color:var(--neon-gold,#ffd166);text-decoration:none}
.gdex{border:1px solid var(--gold,#d4a017);border-radius:12px;padding:12px 14px;margin:14px 0;background:rgba(0,0,0,.28)}
.gdex h3{margin:0 0 10px;font-family:Orbitron,sans-serif;font-size:.8rem;letter-spacing:1px;color:#ffd166}
.gdex-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.gdex-col{background:rgba(255,255,255,.04);border-radius:10px;padding:8px 10px}
.gdex-h{font-weight:700;font-size:.8rem;margin-bottom:6px;display:flex;align-items:center;gap:6px}
.gdex-row{display:flex;justify-content:space-between;gap:8px;font-size:.72rem;padding:3px 0;border-bottom:1px dashed rgba(255,255,255,.07)}
.gdex-row a,.gdex-all{color:var(--neon-gold,#ffd166);text-decoration:none}.gdex-row span{color:#aaa;text-align:right}
.gdex-all{display:inline-block;margin-top:6px;font-size:.7rem}.gdex-empty{font-size:.72rem;color:#888}

.wm-bg{position:fixed;inset:0;background:rgba(0,0,0,.72);display:flex;align-items:center;justify-content:center;z-index:99999;padding:16px}
.wm-box{width:min(420px,100%);max-height:90vh;overflow:auto;background:#0b0d14;border:1px solid var(--gold,#d4a017);border-radius:16px;padding:16px;color:#eee;box-shadow:0 10px 40px rgba(0,0,0,.6)}
.wm-h{display:flex;justify-content:space-between;align-items:center;font-family:Orbitron,sans-serif;font-size:.85rem;letter-spacing:1px;color:#ffd166;margin-bottom:6px}
.wm-x{background:none;border:0;color:#aaa;font-size:1.2rem;cursor:pointer}
.wm-sec{font-size:.66rem;color:#8a8fa3;margin:12px 0 4px;letter-spacing:.5px}
.wm-btn{display:flex;align-items:center;gap:10px;width:100%;padding:12px;margin:6px 0;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:#fff;font-size:.9rem;cursor:pointer;text-decoration:none;box-sizing:border-box;min-height:44px}
.wm-btn:hover{border-color:var(--gold,#d4a017)}.wm-btn img{width:26px;height:26px;border-radius:6px}
.wm-note{font-size:.7rem;color:#8a8fa3;margin-top:12px;line-height:1.4}
.wm-disc{display:none;margin:6px auto 0;background:none;border:1px solid rgba(255,255,255,.2);color:#aaa;border-radius:999px;padding:4px 12px;font-size:.72rem;cursor:pointer}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/hls.js/1.4.12/hls.min.js" crossorigin="anonymous"></script>
<style id="at-au-style">
.at-wrap{display:grid;gap:14px}
.at-card{display:grid;grid-template-columns:104px 1fr;gap:14px;padding:16px;border:1px solid rgba(212,160,23,.45);border-radius:14px;background:radial-gradient(120% 140% at 0% 0%,#241b09 0%,#0b0b10 62%)}
.at-coin{width:104px;height:104px;border-radius:50%;padding:4px;background:conic-gradient(from 210deg,#ffc83b,#7a5a0a,#ffc83b,#d4a017,#ffc83b);box-shadow:0 0 22px rgba(255,200,59,.28)}
.at-coin img{width:100%;height:100%;border-radius:50%;display:block;background:#000;object-fit:cover}
.at-name{font-family:Orbitron,sans-serif;font-size:1rem;color:var(--neon-gold);margin:0}
.at-sym{font-size:.74rem;color:#9a9aa8}
.at-facts{display:grid;grid-template-columns:auto 1fr;gap:3px 10px;margin:8px 0;font-size:.72rem;color:#aaa}
.at-facts b{color:#ddd;font-weight:600;word-break:break-all}
.at-links{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.74rem}
.at-links a{color:var(--neon-gold);text-decoration:underline;text-underline-offset:3px}
.at-act{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.at-btn{flex:1;min-width:150px;padding:10px 12px;border:0;border-radius:10px;font-weight:700;cursor:pointer;background:linear-gradient(135deg,#ffc83b,#d4a017);color:#1a1200}
.at-btn.alt{background:transparent;color:var(--neon-gold);border:1px solid var(--gold)}
.at-btn:focus-visible{outline:2px solid #fff;outline-offset:2px}
.at-state{font-size:.74rem;min-height:1em;flex-basis:100%}
@media(max-width:520px){.at-card{grid-template-columns:1fr;justify-items:start}}
.au-card{margin-top:16px;padding:14px;border:1px solid var(--gold);border-radius:12px;background:linear-gradient(160deg,#17120a,#0b0b10)}
.au-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:12px}
.au-grid label{font-size:.7rem;color:#aaa;display:grid;gap:3px}
.au-grid input{width:100%}
.au-log{max-height:160px;overflow:auto;white-space:pre-wrap;font:11px/1.5 monospace;color:#9fd;background:#06060a;border:1px solid #222;border-radius:8px;padding:8px;margin-top:10px}
.tk-cov{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.tk-chip{font-size:.68rem;padding:2px 8px;border-radius:999px;border:1px solid #555;color:#aaa}
.tk-chip.ok{color:var(--cyber-green);border-color:var(--cyber-green)}
.tk-chip.no{color:#ff4d4d;border-color:#ff4d4d}
.tk-links{display:grid;gap:5px;font-size:.74rem;margin-top:6px}
.tk-links a{color:var(--neon-gold);text-decoration:underline;text-underline-offset:3px}
.tk-links small{color:#8a8a99;word-break:break-all}
.tk-hub{margin-top:16px;padding:14px;border:1px solid rgba(212,160,23,.35);border-radius:12px}
.at-row{display:flex;gap:8px;margin:6px 0}
.at-row input{flex:1;min-width:0}
.at-quick{font-size:.76rem;color:#aaa;margin:2px 0 8px}
.at-quick a{color:var(--neon-gold);margin-left:10px;text-decoration:underline}
input[type=text],input[type=number],input[type=search],textarea{background:#fff;color:#c40000;caret-color:#c40000;font-weight:700;border:1px solid #d4a017;border-radius:8px;padding:8px 10px}
input[type=text]::placeholder,input[type=number]::placeholder,textarea::placeholder{color:#8a6060;font-weight:400;opacity:1}
.input-bottom input{background:transparent;color:#fff;caret-color:var(--neon-gold);border:none;padding:0;border-radius:0}
.input-bottom input::placeholder{color:#777}
.lg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px;margin:8px 0}
.lg-src{display:flex;gap:8px;align-items:flex-start;padding:6px;border:1px solid #2a2a38;border-radius:10px;background:#0b0b10}
.lg-src img,.lg-src .x{width:36px;height:36px;border-radius:50%;flex:none;background:#000;object-fit:cover}
.lg-src .x{display:grid;place-items:center;border:1px solid #ff4d4d;color:#ff4d4d;font-weight:700}
.lg-src b{font-size:.74rem;color:#ddd}
.lg-src span{font-size:.7rem}.lg-src span.ok{color:var(--cyber-green)}.lg-src span.no{color:#ff4d4d}
.lg-src a{display:block;font-size:.64rem;color:var(--neon-gold);word-break:break-all;text-decoration:underline}
.calc-box{margin:12px 0;padding:10px;border:1px solid rgba(212,160,23,.45);border-radius:10px;background:#07070c}
.calc-title{font-family:'Orbitron';font-size:.72rem;color:var(--gold);letter-spacing:1px;margin-bottom:8px}
.calc-disp{width:100%;box-sizing:border-box;text-align:right;font-size:1.05rem;padding:8px 10px;margin-bottom:8px;background:#000;color:#fff;border:1px solid #333;border-radius:6px}
.calc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.calc-grid button{padding:10px 0;border:1px solid #2a2a35;border-radius:6px;background:#12121a;color:#fff;font-size:.95rem;cursor:pointer}
.calc-grid button:hover{background:#1c1c28}.calc-grid button.op{color:var(--neon-gold)}.calc-grid button.eq{background:linear-gradient(135deg,#b8860b,#ffc83b);color:#000;font-weight:800}
</style>
</head>
<body>

<!-- ÜST CANLI FİYAT BANTLARI VE NETWORK SEÇİCİ -->
<div class="top-bar">
    <div class="live-clock" id="live-clock">00:00:00</div>
    <div class="ticker-wrap"><div class="ticker-row" id="global-ticker"><span style="color:#aaa; padding: 0 20px;">ON-CHAIN VERİLERİ BLOKZİNCİRDEN ÇEKİLİYOR...</span></div></div>
    
    <div class="network-container">
        <!-- BSC varsayılan: RSM, ASM ve 20 token burada -->
        <select id="network-selector" class="network-select" onchange="switchNetwork(this.value)">
            <option value="0x2105">Base Network</option>
            <option value="0x38" selected>BSC (BNB Smart Chain)</option>
        </select>
    </div>

    <div class="lang-container">
        <select id="lang-selector" class="lang-select" onchange="changeLanguage(this.value)"><option value="tr">TR 🇹🇷</option><option value="en">EN 🇬🇧</option><option value="de">DE 🇩🇪</option><option value="it">IT 🇮🇹</option><option value="es">ES 🇪🇸</option><option value="ru">RU 🇷🇺</option><option value="ar">AR 🇸🇦</option><option value="zh">ZH 🇨🇳</option><option value="ja">JA 🇯🇵</option></select>
    </div>
</div>

<!-- SOL SABİT YAN PANEL -->
<div class="yan-panel">
    <div style="text-align: center; margin-bottom: 10px;">
        <a href="https://bscscan.com/token/0xf394A750c47DfeEb134C4CbE05AAe13199e88e4e" target="_blank" rel="noopener noreferrer"><img class="panel-resmi" id="logo-rsm" alt="RSM Logo" title="RSM · BscScan"></a>
    </div>

    <!-- RSM kutuları: aslanın (RSM logosu) altında -->
    <div id="side-rsm"><div class="rsm-market-widget" style="text-align:center;color:#aaa;font-size:0.75rem;">Havuzlar okunuyor...</div></div>

    <!-- RSM: bütün DEX'lerdeki havuzlar (DexScreener, BSC) -->
    <div id="side-rsm-alldex"></div>

    <div style="text-align: center; margin-top: 10px;">
        <a href="https://bscscan.com/token/0xE06f8438E12DCE6328eDD94982c7B0882C5A9Cf7" target="_blank" rel="noopener noreferrer"><img class="panel-resmi" id="logo-asm" alt="Karakuzular ASM" title="ASM · BscScan"></a>
    </div>
    <!-- ASM kutuları: kuzunun (ASM logosu) altında -->
    <div id="side-asm"><div class="rsm-market-widget" style="text-align:center;color:#aaa;font-size:0.75rem;">Havuzlar okunuyor...</div></div>

</div>

<!-- ANA İÇERİK DÜZENİ -->
<div class="layout-container">
    <div class="main-panel">
        <h1 id="ui-title">RISASIMANI RASEM GÜROK STOŞHİ</h1>
        <h2 id="ui-subtitle">TRUE DEX ROUTER & ON-CHAIN ENGINE</h2>
        
        <div id="status">OFFLINE • CÜZDAN BAĞLANTISI BEKLENİYOR...</div>
        <button class="main-connect-btn" onclick="connectWallet()" id="connect-btn">Cüzdanı Bağla (Web3 Connect)</button>
        <button class="wm-disc" id="disc-btn" onclick="walletDisconnect()">Bağlantıyı kes</button>

        <!-- RSM rozeti: cüzdan bağlanınca logo burada belirir -->
        <div id="wallet-badge" class="wallet-badge">
            <img id="wb-logo" alt="RSM">
            <div class="wb-text">
                <div class="wb-name">RSM · RISASIMANI</div>
                <div class="wb-addr" id="wb-addr"></div>
            </div>
        </div>

        <!-- TAKAS SEKMELERİ -->
        <div class="tabs-container">
            <button class="tab-btn active" onclick="switchTab('main', this)" id="tab-btn-main">ANA DEX</button>
            <button class="tab-btn" onclick="switchTab('btc', this)" id="tab-btn-btc">BTC TAKAS</button>
            <button class="tab-btn" onclick="switchTab('eth', this)" id="tab-btn-eth">ETH TAKAS</button>
            <button class="tab-btn" onclick="switchTab('addtoken', this)" id="tab-btn-addtoken">🪙 TOKEN EKLE</button>
            <button class="tab-btn hidden" onclick="switchTab('arb', this)" id="tab-btn-arb">⚡ ARBİTRAJ (owner)</button>
        </div>

        <!-- 1. ANA TAKAS BÖLÜMÜ (Tüm Tokenler) -->
        <div class="swap-container active" id="tab-main">
            <div class="swap-box-header">
                <h3>🔄 ON-CHAIN ROUTER (ALL TOKENS)</h3>
                <span class="tag" id="main-router-tag">ROUTER</span>
            </div>
            
            <div class="token-input-row">
                <div class="input-top">
                    <span>Satılan (From)</span>
                    <span>Bakiye: <span class="highlight" id="main-from-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="number" id="main-from-amount" placeholder="0.0" oninput="calculateQuote('main')">
                    <select class="token-select" id="main-from-token" onchange="onTokenChange('main')"></select><img class="tok-chip" id="main-from-logo" alt="">
                </div>
            </div>

            <div class="switch-btn-row">
                <button class="switch-btn" onclick="flipTokens('main')">↓</button>
            </div>

            <div class="token-input-row">
                <div class="input-top">
                    <span>Alınan (To - Tahmini)</span>
                    <span>Bakiye: <span class="highlight" id="main-to-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="text" id="main-to-amount" placeholder="0.0" readonly>
                    <select class="token-select" id="main-to-token" onchange="onTokenChange('main')"></select><img class="tok-chip" id="main-to-logo" alt="">
                </div>
            </div>

            <!-- Slippage & Route Info -->
            <div class="slippage-box">
                <span>Kayma Toleransı (Slippage):</span>
                <div class="slippage-opts">
                    <button class="slip-btn" onclick="setSlippage(0.1, this)">0.1%</button>
                    <button class="slip-btn active" onclick="setSlippage(0.5, this)">0.5%</button>
                    <button class="slip-btn" onclick="setSlippage(1.0, this)">1.0%</button>
                </div>
            </div>

            <div class="info-row">
                <span>Tahmini Kur:</span>
                <span class="highlight" id="main-exchange-rate">1 Token = --</span>
            </div>
            <div class="info-row">
                <span>Yönlendirme Protokolü:</span>
                <span style="color:var(--cyber-green);" id="main-router-protocol">Blokzincir Üzerinden Otomatik Yönlendirme</span>
            </div>

            <div class="action-btn-group">
                <button class="action-btn btn-action-approve" id="main-approve-btn" onclick="executeApprove('main')" disabled>ONAYLA (APPROVE)</button>
                <button class="action-btn btn-action-swap" id="main-swap-btn" onclick="executeSwap('main')" disabled>TAKAS ET (SWAP)</button>
            </div>
            <div id="custom-token-box" class="tk-manage">
                <div class="tk-manage-h">🪙 TOKEN LİSTEM <small>manuel ekle · sil</small></div>
                <div class="info-row" style="flex-wrap:wrap;gap:8px;margin-top:8px">
                    <input type="text" id="custom-token-addr" placeholder="0x… kontrat adresi" style="flex:1;min-width:180px" oninput="tkAuto(this.value)">
                    <button class="action-btn btn-action-approve" style="flex:0 0 auto;padding:8px 14px" onclick="addCustomToken()">EKLE</button>
                </div>
                <div id="custom-token-msg" class="hint" style="font-size:12px;color:#aaa;margin-top:6px"></div>
                <div id="custom-token-list" class="tk-list"></div>
            </div>
            <a class="rsm-ad" href="https://risasimanirasemdappbank.netlify.app/" target="_blank" rel="noopener noreferrer" aria-label="RISASIMANI (RSM) reklamı"><small>REKLAM</small><img width="600" height="200" alt="RISASIMANI · RSM · BNB Smart Chain · BEP-20 · Global DeFi &amp; Web3 Ecosystem" src="data:image/jpeg;base64,"></a>
            <div id="custom-token-card" style="margin-top:10px"></div>
        </div>

        <!-- 2. BTC DEDİKED TAKAS BÖLÜMÜ -->
        <div class="swap-container" id="tab-btc">
            <div class="swap-box-header">
                <h3 style="color:#f2a900;">🟠 BTC EXPRESS EXCHANGE</h3>
                <span class="tag">WRAPPED BTC ROUTER</span>
            </div>

            <div class="token-input-row">
                <div class="input-top">
                    <span>Ödenen Token</span>
                    <span>Bakiye: <span class="highlight" id="btc-from-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="number" id="btc-from-amount" placeholder="0.0" oninput="calculateQuote('btc')">
                    <select class="token-select" id="btc-from-token" onchange="onTokenChange('btc')"></select><img class="tok-chip" id="btc-from-logo" alt="">
                </div>
            </div>

            <div class="switch-btn-row">
                <button class="switch-btn" onclick="flipTokens('btc')">↓</button>
            </div>

            <div class="token-input-row">
                <div class="input-top">
                    <span>Alınan Bitcoin (BTC)</span>
                    <span>Bakiye: <span class="highlight" id="btc-to-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="text" id="btc-to-amount" placeholder="0.0" readonly>
                    <select class="token-select" id="btc-to-token" onchange="onTokenChange('btc')"></select><img class="tok-chip" id="btc-to-logo" alt="">
                </div>
            </div>

            <div class="info-row">
                <span>BTC Değişim Oranı:</span>
                <span class="highlight" id="btc-exchange-rate">Calculated on-chain</span>
            </div>

            <div class="action-btn-group">
                <button class="action-btn btn-action-approve" id="btc-approve-btn" onclick="executeApprove('btc')" disabled>BTC İÇİN ONAYLA</button>
                <button class="action-btn btn-action-swap" id="btc-swap-btn" onclick="executeSwap('btc')" disabled>BTC TAKAS ET</button>
            </div>
        </div>

        <!-- 3. ETH DEDİKED TAKAS BÖLÜMÜ -->
        <div class="swap-container" id="tab-eth">
            <div class="swap-box-header">
                <h3 style="color:#627eea;">🔷 ETH EXPRESS EXCHANGE</h3>
                <span class="tag">ETHEREUM ROUTER</span>
            </div>

            <div class="token-input-row">
                <div class="input-top">
                    <span>Ödenen Token</span>
                    <span>Bakiye: <span class="highlight" id="eth-from-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="number" id="eth-from-amount" placeholder="0.0" oninput="calculateQuote('eth')">
                    <select class="token-select" id="eth-from-token" onchange="onTokenChange('eth')"></select><img class="tok-chip" id="eth-from-logo" alt="">
                </div>
            </div>

            <div class="switch-btn-row">
                <button class="switch-btn" onclick="flipTokens('eth')">↓</button>
            </div>

            <div class="token-input-row">
                <div class="input-top">
                    <span>Alınan Ether (ETH)</span>
                    <span>Bakiye: <span class="highlight" id="eth-to-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="text" id="eth-to-amount" placeholder="0.0" readonly>
                    <select class="token-select" id="eth-to-token" onchange="onTokenChange('eth')"></select><img class="tok-chip" id="eth-to-logo" alt="">
                </div>
            </div>

            <div class="info-row">
                <span>ETH Değişim Oranı:</span>
                <span class="highlight" id="eth-exchange-rate">Calculated on-chain</span>
            </div>

            <div class="action-btn-group">
                <button class="action-btn btn-action-approve" id="eth-approve-btn" onclick="executeApprove('eth')" disabled>ETH İÇİN ONAYLA</button>
                <button class="action-btn btn-action-swap" id="eth-swap-btn" onclick="executeSwap('eth')" disabled>ETH TAKAS ET</button>
            </div>
        </div>

<!-- ARBİTRAJ (yalnız owner) -->
<div class="swap-container" id="tab-arb">
  <div class="swap-box-header"><h3 style="color:#ffd166;">⚡ ARBİTRAJ · FLASH-LOAN</h3><span class="tag">OWNER</span></div>
  <div class="arb-card">
